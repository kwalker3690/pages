<HEAD><style>/* ===================== VOILE — gallery-white wedding portfolio ==================== */
/* Palette lives ONLY in theme fields; author CSS consumes the emitted vars. */

/* ---- Type system: didone display where display type lives (h1/h2/title/display; h3/h4 ride the subheading roleStyle's text face — unlayered author CSS would beat that knob, so the selector stays off them) ---- */
h1.gml-heading, h2.gml-heading, .gml-title, .gml-display { font-family: var(--heading-font); }

/* Notation tier: h4 is the italic-serif side voice (sentence case, muted) */

/* Inline semantic color — recolor = theme edit only */
span.textColor[data-variant='accent'] { color: var(--accent-color); }
span.textColor[data-variant='muted'] { color: var(--body-color-muted); }
.gml-card .section-group { margin-block-start: var(--heading-gap-above); }

/* The vow register: the statement voice — didone italic, sentence case, untracked */
.vow .gml-display, .vow h1.gml-heading, .vow h2.gml-heading { font-style: italic; text-transform: none; letter-spacing: 0; line-height: 1.15; }

/* ---- Canvas: print-album corners are square (NOTES.md: register decision) ---- */
.gml-grid-cell { --cell-radius: 0; }

/* ---- Ornament vocabulary: the letterpress tick (short ink hairline) ---- */
.tick { --divider-color: var(--heading-color); --divider-thickness: 1px; }
.tick.gml-divider { margin: 16pt 0; }
.gml-divider.tick { width: 44pt; }

/* ---- Matted plate: the album mount — pure-white mat, hairline edge, caption below ---- */
.mat .gml-figure { background: var(--surface-color); border: 1px solid var(--neutral-border-color); padding: 8pt; aspect-ratio: 4 / 3; }
.mat .gml-figure__img { width: 100%; height: 100%; object-fit: cover; }
.mat-tall .gml-figure { aspect-ratio: 4 / 5; }
.mat-wide .gml-figure { aspect-ratio: 12 / 5; }

/* ---- Freeform paper folio: purposeful overlap, with its own box inset ---- */
.paper-folio.gml-box, .wall-label.gml-box { border: 1px solid var(--neutral-border-color); box-shadow: none; }
.paper-folio.gml-box { padding: 30pt 34pt; --block-gap: 7pt; }
.wall-label.gml-box { padding: 18pt 22pt; --block-gap: 5pt; }

/* ---- Icon-led field guide: pictograms behave like letterpress marginalia ---- */
.field-guide { --grid-seam-inset: 1.1em; }
.field-guide .gml-cell-label { color: var(--accent-color); justify-content: flex-start; margin-block-end: 8pt; }
.field-guide .gml-icon { width: 30pt; height: 30pt; font-size: 24pt; color: var(--accent-color); }

/* ---- The marque: letterpress studio name / wordmark register ---- */
.marque p.gml-paragraph { font-family: var(--heading-font); text-transform: uppercase; letter-spacing: 0.12em; color: var(--heading-color); }

/* ---- Ledger rows: hairline seams, small-caps lead tokens ---- */
/* Seam density is a theme knob, not per-cell padding: ledger rows sit tighter
   on their rules than the 18pt default (the seam-inset token, per line-facing side). */
.led { --grid-seam-inset: 11.5pt; }
.led p.gml-paragraph b { color: var(--heading-color); font-weight: 600; }
.led p.gml-paragraph i { color: var(--body-color-muted); }

/* Folio tokens. Arabic sequences ride the native number marker (it renumbers on
   reorder); roman folio numerals stay typed in an accent span, since marker
   numbering cannot format romans. Both wear the same letterpress token. */
.numbered .gml-grid-cell__marker { color: var(--accent-color); font-weight: 500; letter-spacing: 0.12em; margin-right: 8pt; }
.numbered p.gml-paragraph > span.textColor[data-variant='accent']:first-child { font-weight: 500; letter-spacing: 0.12em; }

/* ---- Bullets: quiet driftwood en-rule markers ---- */
li.gml-bullet::marker { color: var(--accent-color); content: '\2013\00a0\00a0'; }

/* ---- Prose columns get wider seam clearance (QUALITY-RULES 12b) ---- */
.cols { --grid-seam-inset: 1.1em; }

/* ---- Pull quote: bar hidden, didone italic claim, letterpress attribution ---- */
.gq.gml-blockquote { padding-inline-start: 0; }
.gq.gml-blockquote > .gml-blockquote__bar { display: none; }
.gq p.gml-paragraph { font-family: var(--heading-font); font-style: italic; line-height: 1.35; color: var(--heading-color); }

/* ---- Stat numerals: didone giants, tight leading ---- */
.stat [data-size], .stat .gml-display { line-height: 1; }
.stat h3.gml-heading { letter-spacing: 0.12em; }

/* ---- Tables: hairline ledger, letterpress header over a strong rule ---- */
.gml-table { --table-border-color: var(--neutral-border-color); --table-cell-padding: 10pt 14pt 10pt 2pt; --table-header-color: var(--accent-color); --table-header-weight: 500; --table-radius: 0; }
.gml-table__cell p.gml-paragraph { font-family: var(--body-font); color: var(--body-color); }
.gml-table__row[data-header] .gml-table__cell { letter-spacing: 0.12em; text-transform: uppercase; font-size: calc(10.5 * var(--type-anchor, 1pt)); border-bottom: 1px solid var(--heading-color); }
.metrics .gml-table__cell:last-child { text-align: end; font-variant-numeric: tabular-nums; }
.gml-table__row:last-child .gml-table__cell { border-bottom: var(--table-border-width) solid var(--table-border-color); }
/* Option comparison (voile25): the header row carries didone option names rather
   than the letterpress key, and column 0 is the caption-register attribute rail. */
.albumcmp { --table-header-color: var(--heading-color); --table-header-weight: 400; }
.albumcmp .gml-table__row[data-header] .gml-table__cell { text-transform: none; letter-spacing: 0.01em; font-size: calc(16 * var(--type-anchor, 1pt)); border-bottom: 1px solid var(--neutral-border-color); }
.albumcmp .gml-table__row[data-header] .gml-table__cell p.gml-paragraph { font-family: var(--heading-font); font-style: italic; color: var(--heading-color); }
.albumcmp .gml-table__cell[data-col='0'] { text-transform: uppercase; letter-spacing: 0.12em; font-size: calc(10.5 * var(--type-anchor, 1pt)); }
.albumcmp .gml-table__cell[data-col='0'] p.gml-paragraph { color: var(--body-color-muted); }

/* ---- Running chrome: letterpress folio ---- */
.gml-card__footer { font-family: var(--body-font); font-weight: 500; font-size: calc(10 * var(--type-anchor, 1pt)); letter-spacing: 0.12em; text-transform: uppercase; color: var(--body-color-muted); }
.gml-card__margin-el--page-number { color: var(--accent-color); }

/* ---- The album spread: facing pages of the sewn album (albook/pg register) ---- */
.albook .pg { border: 1px solid var(--neutral-border-color); --cell-default-bg: var(--surface-color); box-shadow: 0 10pt 22pt color-mix(in srgb, var(--heading-color) 13%, transparent); }
.albook .pg-l { border-right: none; box-shadow: inset -14pt 0 16pt -14pt color-mix(in srgb, var(--heading-color) 22%, transparent), 0 10pt 22pt color-mix(in srgb, var(--heading-color) 13%, transparent); }
.albook .pg-r { border-left: none; box-shadow: inset 14pt 0 16pt -14pt color-mix(in srgb, var(--heading-color) 22%, transparent), 0 10pt 22pt color-mix(in srgb, var(--heading-color) 13%, transparent); }
.albook .pg .gml-figure { border: 1px solid var(--neutral-border-color); }

/* ---- Sparse type-led cover (voile33): small proof plate offset high-right ---- */
.voile33 .proof.gml-figure {
  background: var(--surface-color);
  border: 1px solid var(--neutral-border-color);
  padding: 8pt;
  aspect-ratio: 16 / 9;
}
.voile33 .proof .gml-figure__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.voile33 .place {
  margin-block-start: calc(var(--block-gap) * 0.45);
}

/* ---- Image-free agenda index (voile35): ruled act entries beside a narrow title rail ---- */
/* Act rows sit closer to their hairlines than the 18pt default — seam density is a theme
   knob so the entries' own marginal-numeral columns stay unpadded. */
.acts { --grid-seam-inset: 14pt; }
/* The act title shares its baseline band with the marginal roman in the gutter cell, so it
   sits flush at the top of its column instead of taking the heading's rhythm margin. */
.act-title {
  margin-block-start: 0;
}
.act-copy {
  margin-block-start: calc(var(--block-gap) * 0.4);
}

/* Graphy charts: gallery figures — driftwood lead over sea mist, hairline apparatus, square print-album marks, italic legend */
.gml-chart {
  --gamma-chart-background: transparent;
  --gamma-chart-grid-color: color-mix(in srgb, var(--body-color) 8%, transparent);
  --gamma-chart-grid-dasharray: none;
  --gamma-chart-border-color: transparent;
  --gamma-chart-axis-line-color: transparent;
  --gamma-chart-origin-line-color: color-mix(in srgb, var(--body-color) 35%, transparent);
  --gamma-chart-text-color: var(--body-color-muted);
  --gamma-chart-secondary-text-color: var(--body-color-muted);
  --gamma-chart-legend-background: transparent;
  --gamma-chart-legend-border-color: transparent;
  --gamma-chart-legend-item-background: transparent;
  --gamma-chart-legend-item-border: none;
  --gamma-chart-legend-item-shadow: none;
  --gamma-chart-legend-text-color: var(--body-color);
  --gamma-chart-legend-font-style: italic;
  --gamma-chart-bar-rx: 0;
  --gamma-chart-bar-ry: 0;
  /* Series 5-8: tints of the four voices so long series stay on-register */
  --gamma-chart-line-width: 1.5px;
  --gamma-chart-line-cap: butt;
  --gamma-chart-area-opacity: 0.08;
  --gamma-chart-pie-stroke: var(--card-color);
  --gamma-chart-pie-stroke-width: 1.5px;
}</style></HEAD>
<section image-layout="blank" id="PHAobVIT0J" vertical-align="start" card-margin-hidden="true"><grid spacing="none"><grid-item id="hPGAgRAjQd"><p role="eyebrow" align="center">Lune &amp; Ash · Autumn/Winter 2026 Collection</p><grid spacing="none"><spacer mode="fill"></spacer><grid-item id="9nbiQ89FCK" class="mat mat-wide" padding="6pt 0 0 0" colspan="42"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/ve8H-f7g96lytR4wanC6b.png" saved-media-id="cht1nnyp3azdquj" source="image.ai-generated" image-style="voile-documentary" alt="Warm ivory-toned fine-art documentary photograph of a hairstylist making the final fingertip adjustments to an airy jaw-length bob on a seated client, quiet Portland studio in natural window light, subtle film grain, restrained stone and mineral palette, candid mid-moment framing, no visible text or logos" meta="{&quot;width&quot;:1920,&quot;height&quot;:1088}"></grid-item><spacer mode="fill"></spacer></grid><h1 font-size="36pt" align="center">Undone on Purpose</h1><p role="caption" align="center">Eight looks from the studio floor, and exactly what to ask for.</p></grid-item></grid></section>
<section image-layout="blank" id="snKJPB1_0V"><grid spacing="none"><grid-item id="9qRgorsaD_" padding="0" colspan="16"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/_6TlHivhUDlSbBZPk2ynO.png" saved-media-id="b332bp9kg35vnpk" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned documentary portrait of a person with loose, deliberately imperfect layered hair pulling on a wool coat beside a rain-marked salon window, natural grey morning light, subtle film grain, restrained stone and mineral palette, candid and unposed, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="5XVBb7US0Q" padding="38pt 42pt" colspan="44"><p role="eyebrow">The collection</p><h2>The season's idea: effort you can't see</h2><p>Every look is built for a week of real life: wet mornings, wool collars, no round brush.</p><grid divider="0.75pt neutral-border" class="field-guide section-group"><grid-item id="iBwsymVags" colspan="30"><grid-item-label><icon src="https://iconscdn.pictographic.ai/image/p4OMq3l5jrKS5GczguBp.svg?stroke=45" source="image.pictographic.icon" alt="loose layered haircut silhouette" meta="{&quot;description&quot;:&quot;A pair of scissors with open blades, used for cutting hair, symbolizing a haircut or barber service.&quot;}"></icon></grid-item-label><h3>Recognisable shapes</h3><p>Bob, shag and pixie, cut loose rather than prescribed. <a href="https://www.marieclaire.com/beauty/hair/best-fall-2026-haircuts/">Marie Claire</a></p></grid-item><grid-item id="N_8-qoOJNm" colspan="30"><grid-item-label><icon src="https://iconscdn.pictographic.ai/image/1gkhUjJTnIGdposlHtz1.svg?stroke=45" source="image.pictographic.icon" alt="blended dimensional hair colour" meta="{&quot;description&quot;:&quot;A black comb shape with a group of prongs in the center, symbolizing the concept of hair.&quot;}"></icon></grid-item-label><h3>Blended colour</h3><p>Dimensional placement grows out without a hard line. <a href="https://menagerienc.com/lived-in-color-spring-2026-trend/">Menagerie</a> · <a href="https://www.glamour.com/gallery/best-hair-color-ideas">Glamour</a></p></grid-item><grid-item id="4tV5lrMWqe" colspan="30"><grid-item-label><icon src="https://iconscdn.pictographic.ai/image/F9z5GdjSkk6HMmjD69gk.svg?stroke=45" source="image.pictographic.icon" alt="shining healthy hair strand" meta="{&quot;description&quot;:&quot;A single, unbroken thread or fiber, symbolizing the concept of a strand, conveying unity and continuity.&quot;}"></icon></grid-item-label><h3>Gloss finish</h3><p>A shine service makes colour read richer and hair read healthier. <a href="https://www.cosmopolitan.com/style-beauty/beauty/a73643155/fall-hair-color-trends-2026/">Cosmopolitan</a></p></grid-item><grid-item id="FK9jnfq2E8" colspan="30"><grid-item-label><icon src="https://iconscdn.pictographic.ai/image/BEXne7UKit1xOEmkSMeo.svg?stroke=45" source="image.pictographic.icon" alt="salon chair and simple home routine" meta="{&quot;description&quot;:&quot;A pair of scissors inside a rounded square shape, associated with hair cutting or styling services.&quot;}"></icon></grid-item-label><h3>Chair versus home</h3><p>More work in the chair. Less work in your bathroom.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="-hFwgaPUok" card-margin-hidden="true"><grid spacing="none" class="vow"><grid-item id="p6wmLqBBrQ" padding="52pt 48pt 46pt 48pt" colspan="60"><p role="eyebrow">The sentence behind the collection</p><spacer mode="fill"></spacer><display size="md" font-size="40pt">“The strongest hair right now feels designed, but not over-designed.”</display><hr class="tick"><p role="caption">Adam Federico · Vice President of Technical Education, R+Co · <a href="https://www.marieclaire.com/beauty/hair/best-fall-2026-haircuts/">Marie Claire</a></p><p>It's the sentence we kept coming back to while building this collection.</p></grid-item></grid></section>
<section image-layout="blank" id="rLVZbuLZZg" card-margin-hidden="true"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/omxMWW3iTsd8vj0OWP-yI.png" saved-media-id="gnx4p7abxme64i5" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned fine-art documentary photograph of a hairstylist cutting a soft jaw-length bob, scissors and comb caught mid-motion beside the client's cheek, natural window light in a quiet studio, subtle film grain, restrained stone and mineral palette, candid working moment, no visible text or logos" meta="{&quot;width&quot;:1920,&quot;height&quot;:1088}"><freeform><box type="content" x="34" y="386" w="360" h="112" sizing="fixed" class="wall-label" background-color="surface" style="border-radius: 0;"><h1 font-size="28pt" align="left">Part One — The Cuts</h1></box></freeform></section>
<section image-layout="blank" id="5XCNESTwJf"><grid spacing="none"><grid-item id="E0HbH6uqwK" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/YOVbHG9uB7Wnpp5A5oWBa.png" saved-media-id="1cps9jc7h7b799e" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client in three-quarter profile with a soft jaw-to-collarbone boyfriend bob, airy unblunt ends tucked behind one ear, natural salon window light, subtle film grain, restrained stone palette, real hair texture, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="Y8VwZhSYck" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Cut collection · I</p><h2 font-size="24pt">01 — The Boyfriend Bob</h2><p>A jaw-to-collarbone bob, soft at the edge and airy inside. The opposite of tight and tailored: it tucks behind an ear and looks worn-in on day one.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="VgNCsijnL9"><p font-size="12.5pt"><b>Ask</b> · Soft, unblunt perimeter; invisible internal weight removal.</p></grid-item><grid-item id="37n9nfux-L"><p font-size="12.5pt"><b>Best</b> · Straight to loose wave; medium density.</p></grid-item><grid-item id="mdj0OFoEAc"><p font-size="12.5pt"><b>Home</b> · Air-dry; one flat-iron pass only if wanted.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.allure.com/story/fall-hair-trends-2026">Allure</a></p></grid-item></grid></section>
<section image-layout="blank" id="TGb11xocKG"><grid spacing="none"><grid-item id="Z2oR8_G59w" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/1bkUTYmoN6yR394FBij1W.png" saved-media-id="3brhf0bfz7qwc8y" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with long thick hair and shattered face-framing layers, strong full perimeter and visible movement through the front, hair lifted lightly by studio air, natural window light, subtle film grain, restrained mineral palette, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="EFeNSo2S9X" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Cut collection · II</p><h2 font-size="24pt">02 — Long, Shattered Layers</h2><p>Length kept, weight broken. A strong perimeter holds the line while face-framing pieces move, so long layers do not collapse into flat curtains by Wednesday.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="3ZUGHj7X66"><p font-size="12.5pt"><b>Ask</b> · Strong perimeter, dynamic face frame, minimal wispy disconnection.</p></grid-item><grid-item id="Ybe7UmTcPy"><p font-size="12.5pt"><b>Best</b> · Thick or coarse hair carrying weight at the ends.</p></grid-item><grid-item id="AE1KhArjJH"><p font-size="12.5pt"><b>Home</b> · Rough-dry upside down; wait until 80% dry for product.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend notes · <a href="https://www.whowhatwear.com/beauty/hair/autumn-hair-trends-2026">Who What Wear</a> · <a href="https://www.marieclaire.com/beauty/hair/best-fall-2026-haircuts/">Marie Claire</a></p></grid-item></grid></section>
<section image-layout="blank" id="Gm9rfADaCR"><grid spacing="none"><grid-item id="S1KAx8T_NV" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/mvNyX0Z_mVHC72eD7fiNR.png" saved-media-id="s5cy2efbyqkae0f" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with wispy cloud bangs sitting softly across the forehead and blending into long face-framing pieces, fingertips pushing part of the fringe aside, natural window light, subtle film grain, restrained blush and stone palette, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="NGk7VL3X-R" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Cut collection · III</p><h2 font-size="24pt">03 — Cloud Bangs</h2><p>Wispy and flexible, with no hard commitment. They sit softly across the forehead, disappear into the length when pushed aside, and do not demand a blow-dry.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="-Z9842ZqDl"><p font-size="12.5pt"><b>Ask</b> · Airy bangs, point-cut into the face-framing layers.</p></grid-item><grid-item id="8eU97skIbq"><p font-size="12.5pt"><b>Best</b> · Anyone nervous about bangs; this is the lowest-risk version.</p></grid-item><grid-item id="S1rCxDK5BV"><p font-size="12.5pt"><b>Upkeep</b> · Free fringe trim between appointments; ten minutes.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.allure.com/story/fall-hair-trends-2026">Allure</a></p></grid-item></grid></section>
<section image-layout="blank" id="ZI1uwFJ7gf"><grid spacing="none"><grid-item id="QmeA4QQ8x1" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/-Pq-taSMOkzRLHcUENKjI.png" saved-media-id="24p129yfhai4bq8" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with a quiet textured crop shaped around natural curls and a visible cowlick, fingers lightly separating damp pieces, soft salon window light, subtle film grain, restrained stone and mineral palette, individual real texture, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="rUDB7h-7Nv" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Cut collection · IV</p><h2 font-size="24pt">04 — The Quiet Crop</h2><p>Short hair shaped with your texture, not against it. A little imperfection stays in on purpose, so the cut follows your growth pattern instead of imposing one.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="mvy7cPu6ij"><p font-size="12.5pt"><b>Ask</b> · A crop built around natural growth patterns and cowlicks.</p></grid-item><grid-item id="vxTo53aAHR"><p font-size="12.5pt"><b>Best</b> · Wave and curl, where texture carries the shape.</p></grid-item><grid-item id="pk5cESq001"><p font-size="12.5pt"><b>Home</b> · A pea of cream on damp hair; fingers only.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.marieclaire.com/beauty/hair/best-fall-2026-haircuts/">Marie Claire</a></p></grid-item></grid></section>
<section image-layout="blank" id="HTiA9Bf8T1" card-margin-hidden="true"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/qiF9Np_8H1dQKw9yZhJ4p.png" saved-media-id="mq996w5wkz4vp7a" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned fine-art documentary photograph of a colourist brushing a translucent warm glaze through brunette hair at a porcelain basin, hands and glossy strands caught mid-service, soft natural window light, subtle film grain, restrained blush, stone and mineral palette, no visible text or logos" meta="{&quot;width&quot;:1920,&quot;height&quot;:1088}"><freeform><box type="content" x="34" y="386" w="380" h="112" sizing="fixed" class="wall-label" background-color="surface" style="border-radius: 0;"><h1 font-size="28pt" align="left">Part Two — The Colour</h1></box></freeform></section>
<section image-layout="blank" id="mvh4L58dA5"><grid spacing="none"><grid-item id="ZI-l66MYic" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/n6OTlR-n0j_Mmur5NLT-z.png" saved-media-id="1dnrzbbdwqgbwgx" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with dimensional brunette hair and a softly blurred spiced root, warm brown depth without copper, shoulder-length hair turned toward window light, subtle film grain, restrained stone palette, realistic glossy texture, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="DRt_QXHDOg" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Colour collection · V</p><h2 font-size="24pt">05 — Spiced Smudge</h2><p>Here, a root smudge means a softly blurred root: dimensional brunette underneath, with a spiced tone melted through the root zone. Warm without turning copper.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="pKKRgbRNEq"><p font-size="12.5pt"><b>Ask</b> · A dimensional base with a warm root smudge melted through.</p></grid-item><grid-item id="Rxtz9jrZIK"><p font-size="12.5pt"><b>Why</b> · Richness without high-maintenance brightness.</p></grid-item><grid-item id="cKsGIDYKX-"><p font-size="12.5pt"><b>Grow-out</b> · It softens rather than lines up.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.cosmopolitan.com/style-beauty/beauty/a73643155/fall-hair-color-trends-2026/">Cosmopolitan</a></p></grid-item></grid></section>
<section image-layout="blank" id="RCgVslqsEy"><grid spacing="none"><grid-item id="B9wrGH6QvQ" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/SibCBlI3QvBo3RgrTmMUZ.png" saved-media-id="cmpdaycsca1ci0t" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with khaki bronde hair, muted gold balanced by a whisper of ash, seamless transition from medium brown roots to lighter lengths, natural salon window light, subtle film grain, restrained mineral palette, no green cast, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="Q9KxhF5G9M" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Colour collection · VI</p><h2 font-size="24pt">06 — Khaki Bronde</h2><p>Between blonde and brunette: muted gold with a whisper of ash. A seamless lift lightens without stripes; a colour melt blends the tones over the top.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="uH9M7sVUws"><p font-size="12.5pt"><b>Ask</b> · “A seamless lift and a colour melt.”</p></grid-item><grid-item id="_4AFvF6OTr"><p font-size="12.5pt"><b>Best</b> · Natural level 6–7, going lighter without going blonde.</p></grid-item><grid-item id="3pmlb-cr0H"><p font-size="12.5pt"><b>Note</b> · Nowhere near green, despite the name.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.refinery29.com/en-us/hair-color-trends-2026">Refinery29</a></p></grid-item></grid></section>
<section image-layout="blank" id="pKwY-WTEcF"><grid spacing="none"><grid-item id="_Ey0hWdLq1" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/qad2QHT3GXapsOSXMWLSm.png" saved-media-id="49navxt21j9g15j" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with deep glossy espresso hair, natural dark base and low-contrast tone-on-tone dimension, healthy mirror-like shine under soft window light, subtle film grain, restrained stone and mineral palette, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="Bry7VbyuXX" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Colour collection · VII</p><h2 font-size="24pt">07 — Glossy Espresso</h2><p>Our most-booked service of the season, and the shortest. A zero-lift acidic glaze lays tone and shine over a natural dark base without lightening it.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="hDf1YMazdM"><p font-size="12.5pt"><b>Ask</b> · A demi or acidic gloss to refine your existing depth.</p></grid-item><grid-item id="wNg2ISwUAZ"><p font-size="12.5pt"><b>Chair</b> · Shorter than a cut; the easiest yes on the menu.</p></grid-item><grid-item id="Uya-iFP8ke"><p font-size="12.5pt"><b>Pair</b> · Tone-on-tone colour drenching for low-contrast dimension.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend note · <a href="https://www.wella.com/professional/en-US/blog/hair-color/fall-hair-color-trends">Wella</a></p></grid-item></grid></section>
<section image-layout="blank" id="C-4c5gBYpZ"><grid spacing="none"><grid-item id="8dRz8r6Rgf" padding="0" colspan="28"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/hs_KV09yDE0xA7jf7kGRR.png" saved-media-id="ftc8n5an3mn9gta" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned editorial documentary portrait of a client with luminous champagne blonde hair carrying peach and honey tones, two brighter face-framing money pieces and a soft shadow root, natural salon window light, subtle film grain, restrained blush and stone palette, no visible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item><grid-item id="p7U5Ghawd8" padding="36pt 42pt 32pt 36pt" colspan="32"><p role="eyebrow">Colour collection · VIII</p><h2 font-size="23pt">08 — Champagne Blonde, With the Money Piece</h2><p>Warm and luminous, between platinum and golden, carrying peach and honey. Two brighter face-framing pieces do most of the visual work.</p><grid divider="0.75pt neutral-border" direction="vertical" class="led section-group"><grid-item id="mbgD3vTUy4"><p font-size="12.5pt"><b>Ask</b> · Champagne toning and a face frame matched to your skin tone.</p></grid-item><grid-item id="k_I4qgxgj5"><p font-size="12.5pt"><b>Pair</b> · A shadow root that softens the grow-out.</p></grid-item><grid-item id="DXjXyiDpSR"><p font-size="12.5pt"><b>Impact</b> · The highest-impact, lowest-commitment change on the menu.</p></grid-item></grid><spacer mode="fill"></spacer><p role="caption">Trend notes · <a href="https://www.fergaldoylehair.com/post/blonde-hair-trends-2026-bristol-colour-expert-guide">Fergal Doyle Hair</a> · <a href="https://monarchstudiosd.com/2026/05/07/money-piece-highlights-guide/">Monarch Studios</a></p></grid-item></grid></section>
<section image-layout="blank" id="zOjYwvvlGK" vertical-align="start"><grid spacing="none"><grid-item id="QI-fFa6CLu" padding="38pt 48pt 34pt 48pt"><p role="eyebrow">Studio guidance</p><h2>What each look actually costs you in time</h2><p>the honest version, so nobody books a colour they cannot maintain. Ask us to adjust it to your hair.</p><table col-widths="[30,31,39]" header-row="true" borders="rows" striped="false" class="section-group" style="--table-cell-padding: 8pt 2pt;"><tbody><tr><td><p>Look</p></td><td><p>Back in the chair</p></td><td><p>Between visits</p></td></tr><tr><td><p><b>Boyfriend Bob</b></p></td><td><p>8–10 weeks</p></td><td><p>Nothing</p></td></tr><tr><td><p><b>Shattered Layers</b></p></td><td><p>10–12 weeks</p></td><td><p>Nothing</p></td></tr><tr><td><p><b>Cloud Bangs</b></p></td><td><p>6 weeks</p></td><td><p>Free fringe trim</p></td></tr><tr><td><p><b>Quiet Crop</b></p></td><td><p>5–6 weeks</p></td><td><p>Nothing</p></td></tr><tr><td><p><b>Spiced Smudge</b></p></td><td><p>12–14 weeks</p></td><td><p>Gloss at 8 weeks</p></td></tr><tr><td><p><b>Khaki Bronde</b></p></td><td><p>12–16 weeks</p></td><td><p>Gloss at 8 weeks</p></td></tr><tr><td><p><b>Glossy Espresso</b></p></td><td><p>8 weeks</p></td><td><p>Nothing</p></td></tr><tr><td><p><b>Champagne Blonde</b></p></td><td><p>8–10 weeks</p></td><td><p>Toner at 6 weeks</p></td></tr></tbody></table></grid-item></grid></section>
<section image-layout="blank" id="nSCO1l2TwJ" vertical-align="start"><grid spacing="none"><grid-item id="zWwTS9qvJb"><p role="eyebrow" align="center">Before the chair</p><h2 align="center">Bring three photos, not thirty</h2><p align="center">The consultation goes better when we can see the edges of what you want.</p><grid divider="0.75pt neutral-border" marker="number" marker-position="above" marker-numbering-format="decimal-leading-zero" class="cols numbered section-group"><grid-item id="cDQ5aqQuDi" colspan="20"><h3>Love and refuse</h3><p>Bring one photo you love and one you do not. The refusal often tells us more.</p></grid-item><grid-item id="0TmD5BZ1_l" colspan="20"><h3>Your real mornings</h3><p>Tell us how many minutes you have and which tools are actually in your bathroom.</p></grid-item><grid-item id="iq36AphWLM" colspan="20"><h3>Your colour history</h3><p>Bring the last two years, including the box dye. It changes what is possible today.</p></grid-item></grid><p role="caption" align="center" class="section-group">We will tell you honestly if a look needs two appointments to get right.</p></grid-item></grid></section>
<section image-layout="blank" id="C6TWPJq2vF" card-margin-hidden="true"><grid spacing="none"><grid-item id="xeEIaZbnTt" padding="42pt 42pt 28pt 48pt" colspan="38"><p role="eyebrow">Consultations</p><h1 font-size="31pt">Book the consultation. Decide after.</h1><p>Fifteen minutes, no charge, no obligation to book a service on the day.</p><hr class="tick"><grid divider="0.75pt neutral-border" direction="vertical" class="led"><grid-item id="p-ooYHjb9-"><p role="caption"><b>Visit</b> &nbsp;·&nbsp; Lune &amp; Ash — 214 Mill Street, Portland, Oregon</p></grid-item><grid-item id="KctBqd8sVz"><p role="caption"><b>Hours</b> &nbsp;·&nbsp; Tuesday–Saturday, 9am–7pm</p></grid-item><grid-item id="G47ju04trf"><p role="caption"><b>Write</b> &nbsp;·&nbsp; hello@luneandash.example · Consultations bookable online</p></grid-item></grid><spacer mode="fill"></spacer><p font-size="10pt"><i>Lune &amp; Ash is a fictional salon created for this sample lookbook. All imagery is concept photography, not photographs of client work, and the looks, upkeep guidance, team and contact details are illustrative examples rather than a real business.</i></p></grid-item><grid-item id="r0TyWgrRGR" padding="0" colspan="22"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/HK5LpjdSsvWOgozwt2fgY.png" saved-media-id="nv572sas7myoepr" source="image.ai-generated" background="true" image-style="voile-documentary" alt="Warm ivory-toned documentary photograph of a salon consultation at a pale table, client and stylist hands pointing to three printed hairstyle reference photographs beside a comb and colour swatches, natural window light, subtle film grain, restrained stone and mineral palette, candid working moment, no legible text or logos" meta="{&quot;width&quot;:1248,&quot;height&quot;:1664}"></grid-item></grid></section>