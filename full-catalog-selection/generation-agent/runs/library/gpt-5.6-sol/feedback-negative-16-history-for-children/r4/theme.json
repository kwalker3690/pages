    "imagery": {
      "defaultStyleId": "gouache-cutout",
      "styles": [
        {
          "id": "gouache-cutout",
          "name": "Gouache cutout",
          "styleReferenceKey": "gouache_paint",
          "subjects": "One subject per image, full body, standing free on a transparent background: a single animal character mid-action, a natural prop or place-marker (a boulder, a signpost, a lantern, a footbridge, a basket, an open book, a paper boat), or one small object from the text being taught. Never people's faces, flags, holiday objects, food, currency, desks, laptops, documents, or readable text.",
          "whenToUse": "Use for every cutout that sits in a rounded plate or on bare paper beside type: cover plates, divider plates, peer cells, character discs, timeline and activity spots, and the figure beside a think-aloud bubble. Use gouache-scene when the slot needs a whole place."
        },
        {
          "id": "gouache-scene",
          "name": "Gouache scene",
          "promptGuidance": "matte gouache painting, opaque paint with visible soft brushstrokes and gentle dimensional shading, no ink outlines, warm naturalistic colour with soft marigold, leaf green, brick red and sky blue notes, a sunlit natural setting painted for a children's storybook, one region of the picture left as plain quiet warm cream sky or ground with no detail, no text, no lettering",
          "subjects": "A whole natural place from the text being taught — a meadow path, a stream with stepping stones, a forest edge, a shoreline, a hillside, a garden, a night sky — painted as a scene with depth, with or without a small animal character in it. Never faces, buildings with regional markers, flags, holiday objects, food, currency, or readable text.",
          "whenToUse": "Use for full-bleed cover and closing grounds, the setting plate beside a reading column, gallery cells that compare places, and a single image plate for close looking. When copy will sit on the image, name where the quiet cream region sits. Use gouache-cutout for a single character or object.",
          "references": [
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_a27pt1rrb0wb3es/template-assets/d03d031bf85302b7c54f9c04756c8bb0/01M21XS05EQY6CMD316TXTP3ZK.png",
