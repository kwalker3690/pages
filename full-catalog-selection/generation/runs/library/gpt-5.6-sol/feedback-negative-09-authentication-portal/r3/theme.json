    "imagery": {
      "defaultStyleId": "data-field",
      "styles": [
        {
          "id": "data-field",
          "name": "Data field",
          "promptGuidance": "Abstract data-field illustration: thin, clearly visible pale-cyan line traces on a deep ink-blue-black ground, hairline strokes with sparse tiny node dots, matte flat finish with no glow bloom or blur, large areas of plain dark ground, quiet and non-literal, no letters or numbers, no people.",
          "subjects": "Flowing systems read as line traces: a fibre run, parallel queue lanes, a city at night seen as data, a rack rhythm, control-room waveforms, a partition ring, a widening lag gap, a traffic ramp.",
          "whenToUse": "Ambient field behind or beside the text on covers, section openers, statements, quotes, and the closing. Never behind tables, diagrams, or prose blocks, and never as a stand-in for data.",
          "references": [
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_jxsnezdmaax5cdg/template-assets/f0d13adaf69c5978805f961263560275/01M241E3298YRCF5N046PHQKCC.png",
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_jxsnezdmaax5cdg/template-assets/0207e252559a5055f5ccfbebdff2a3a9/01M241E77F2D8XSYK3MFJVGRP5.png",
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_jxsnezdmaax5cdg/template-assets/b1c402a1d13ea05b097a04f02edd8995/01M241E3C18TA9M4E2P17N5A1P.png",
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_jxsnezdmaax5cdg/template-assets/54b2c6dcbc4013a81bc5b80387aa59b7/01M241E4ZKZ7RZCE48CCGTCK7Y.png"
          ]
        },
        {
          "id": "screen",
          "name": "Schematic screen",
          "promptGuidance": "Schematic screen illustration: a flat, straight-on view of a dark software interface drawn as thin pale-cyan outlines and grey panel blocks on an ink-blue-black ground, with simplified line-chart traces and bar shapes standing in for content, matte finish, no glow, no legible letters or numbers, no hands, no device bezels.",
          "subjects": "Stand-in evidence figures: a monitoring dashboard, a terminal session, a code editor pane, a phone-sized status screen, a topology export, in portrait or landscape.",
          "whenToUse": "Framed evidence figures and evidence sets while no real capture exists. A user's own dashboard, terminal, or phone screenshot replaces it at image-style none inside the same frame; the numbered callouts beside the frame carry the facts, never the picture.",
          "references": [
            "https://cdn-staging.gamma.app/gammatemplatelibrary/g_jxsnezdmaax5cdg/template-assets/84493ecd2086726192d099c72f8abf3b/01M241GH6WRERVZMAV3ZRTWXWX.png",
