<HEAD><style>/* Readable Detail — page sheet. The typeset technical handbook: hairline rules group,
   weight and column position make hierarchy, one accent means "read this first".
   Every colour routes through theme vars; classes carry shape and rhythm only. */

.gml-card {
  --rule: var(--divider-color);
  --hairline: 0.75pt;
  /* A figure caption clears the image crop by a full line of air (renderer knob). */
  --caption-hug-gap: 15pt;
}

/* ── Signature move 3: the topic rule. Every seam in the deck is ONE hairline in the
   theme's divider colour. Grids wearing these register classes draw designed seams. ── */
.sidehead, .columns, .toc, .faq, .steps, .checks, .roles, .pillars, .cover-meta, .stats, .compare {
  --grid-divider-color: var(--rule);
  --grid-divider-width: var(--hairline);
}
.rule.gml-divider { --divider-color: var(--rule); --divider-thickness: var(--hairline); border-radius: 0; }

/* ── Signature move 8: the short accent tick — cover, closing, dark act breaks only. ── */
.tick.gml-divider { --divider-color: var(--accent-color); --divider-thickness: 2pt; border-radius: 0; }
.tick.gml-divider .gml-divider__rule { width: 40pt; margin-inline-start: 0; border-radius: 0; }

/* ── Signature move 1: the side-head. Label column beside a reading column, a hairline
   above each group; the text clears the seam by the seam inset. ── */
.sidehead { --grid-seam-inset: 14pt; }
.sidehead .gml-grid-cell__content { --block-gap: 8pt; }

/* ── Signature move 2: the lede — one 17pt opening sentence, held to a reading measure. ── */
.lede.gml-paragraph { max-width: 600pt; }

/* ── Signature move 4: the running index — "02 · Receiving and release", one per body card. ── */
.meta.gml-paragraph { font-variant-numeric: tabular-nums; margin-block-end: calc(var(--block-gap) * 0.6); }

/* ── Signature move 5: the figure caption — "Figure 4 — a full sentence." (lead in bold serif) ── */
.gloss.gml-paragraph { max-width: 560pt; margin-block-start: calc(var(--block-gap) * 0.5); }

/* ── Signature move 6: the ledger table — plate-tinted sans header row, hairline row rules,
   no vertical rules, numbers right-aligned in tabular figures. ── */
.ledger {
  --table-border-width: var(--hairline);
  --table-border-color: var(--rule);
  --table-header-bg: var(--surface-color);
  --table-header-color: var(--body-color-muted);
  --table-header-weight: 600;
  --table-header-font: var(--heading-font);
  --table-cell-padding: 8pt 12pt 8pt 8pt;
  --table-radius: 0;
}
.ledger .gml-table__cell { font-size: calc(13 * var(--type-anchor, 1pt)); }
.ledger .gml-table__row[data-header] .gml-table__cell { font-size: calc(11 * var(--type-anchor, 1pt)); letter-spacing: 0.01em; }
.ledger .gml-table__cell.num { text-align: end; font-variant-numeric: tabular-nums; }
.ledger .gml-table__row:last-child .gml-table__cell { border-bottom: var(--table-border-width) solid var(--table-border-color); }

/* ── Signature move 7: the claim row — a small caps label beside one sentence. ── */
.claim .gml-label-group { --label-pad-inline: 0; --label-pad-block: 0; }
.claim .gml-grid-cell__content { --block-gap: 4pt; }

/* Cover meta ledger: label/value cells separated by hairline seams (cover-meta class). */
.cover-meta { --grid-seam-inset: 16pt; }
.cover-meta .gml-grid-cell__content { --block-gap: 4pt; }

/* Stat figures: tabular numerals on display nodes. */
.metric { font-variant-numeric: tabular-nums; }
.stats { --grid-seam-inset: 16pt; --cell-decor-color: var(--accent-color); }
.stats .gml-grid-cell__content { --block-gap: 6pt; }

/* Reading columns (two- and three-column text): a tighter paragraph beat inside a column
   than between groups, and a hairline seam between columns. */
.columns { --grid-seam-inset: 22pt; }
.prose .gml-grid-cell__content { --block-gap: 10pt; }

/* Marker numerals and glyphs (agenda, procedure, checklist) set in the heading sans, tabular. */
.toc .gml-grid-cell__marker, .steps .gml-grid-cell__marker, .checks .gml-grid-cell__marker { font-family: var(--heading-font); font-variant-numeric: tabular-nums; }

/* Agenda contents ledger: muted numerals in a fixed gutter. */
.toc { --marker-color: var(--body-color-muted); --marker-inline-size: 36pt; --marker-gap: 14pt; --grid-seam-inset: 14pt; }

/* Numbered procedure: accent numerals inline-left, editorial rows on hairline seams. */
.steps { --marker-color: var(--accent-color); --marker-font-size: 22pt; --marker-font-weight: 700; --marker-inline-size: 44pt; --marker-gap: 16pt; --grid-seam-inset: 14pt; }
.steps .gml-grid-cell__content { --block-gap: 8pt; }

/* Checklist: accent check marks (symbol markers) in the gutter, generous row air. */
.checks { --marker-color: var(--accent-color); --marker-font-weight: 700; --marker-inline-size: 22pt; --marker-gap: 12pt; --grid-seam-inset: 16pt; }

/* FAQ ledger: question column beside answer column, hairline above each pair. */
.faq { --grid-seam-inset: 14pt; }
.faq .gml-grid-cell__content { --block-gap: 6pt; }

/* Icon-led registers: ink glyphs sized to their text, hairline seams. */
.roles { --marker-color: var(--heading-color); --marker-inline-size: 30pt; --marker-gap: 14pt; --grid-seam-inset: 14pt; }
.pillars { --marker-color: var(--heading-color); --grid-seam-inset: 18pt; }
.pillars .gml-grid-cell__content { --block-gap: 8pt; }

/* Comparison columns: peer cells on hairline seams, a tighter beat inside each. */
.compare { --grid-seam-inset: 18pt; }
.compare .gml-grid-cell__content { --block-gap: 8pt; }

/* Figure plates: square corners and a hairline keyline around in-flow figures. */
.plate .gml-figure__img { border: var(--hairline) solid var(--rule); border-radius: 0; }
.plate.gml-grid-cell { --cell-radius: 0; }

/* Evidence cells (chart + gloss) keep the caption close to the plot. */
.evidence .gml-grid-cell__content { --block-gap: 8pt; }

/* Pull quote: a 2pt accent bar, the one accent moment on that card. */
.quote.gml-blockquote { padding-inline-start: 22pt; }
.quote.gml-blockquote > .gml-blockquote__bar { width: 2pt; border-radius: 0; background: var(--accent-color); }

/* Dark act breaks and the closing (root cell painted ink): rules and ticks lift to the
   lightened accent so they read on the ground. */
.act { --rule: var(--body-color-muted); }
.act .tick.gml-divider { --divider-color: var(--palette-3); }
.act .gml-grid-cell__content { --block-gap: 14pt; }

/* Statement: one display-scale claim held to a measure. */
.statement .gml-title { max-width: 760pt; }

/* Running footer: the page number in the sans, tabular. */
.gml-card__footer { font-family: var(--heading-font); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; color: var(--body-color-muted); }</style></HEAD>
<section image-layout="blank" id="RbJ3k8DRt0" card-margin-hidden="true"><grid spacing="none"><grid-item id="1ty1GjVvC1" colspan="36"><labels><label variant="plain">PROJECT HANDOVER FIELD GUIDE · ILLUSTRATIVE REPLACEMENT</label></labels><display size="md">A handover is complete when the work can move without memory</display><p font-size="lg" class="lede">The operating context for the Customer Support Intake Redesign: why it exists, how the service works, what has been decided, what remains uncertain, and who acts next.</p><hr color="accent" thickness="md" width="xxs" class="tick"><p font-size="sm"><b>No project records were supplied.</b> Every status, metric, role, artifact version, and timeline point is a coherent example to replace or validate before operational use.</p><spacer mode="fill"></spacer><grid divider="0.75pt" vertical-sizing="hug" class="cover-meta"><grid-item id="jpQfWqihQ8" colspan="20"><labels><label variant="plain">CURRENT PHASE</label></labels><p font-size="sm">Pilot validation and launch preparation</p></grid-item><grid-item id="dQLxovn2JJ" colspan="20"><labels><label variant="plain">CONDITION</label></labels><p font-size="sm">Needs attention: workflow works; reporting remains unresolved</p></grid-item><grid-item id="SKQiIXCkfl" colspan="20"><labels><label variant="plain">TRANSITION TARGET</label></labels><p font-size="sm">Incoming ownership accepted by T+10 business days</p></grid-item></grid><p role="caption" class="gloss"><b>Critical path —</b> Complete the reporting benchmark, decide D-04, close failed acceptance tests, and confirm launch authority. Immediate action appears on cards 6, 8, and 10.</p></grid-item><grid-item id="WZkaJMdZC6" class="plate" padding="0" colspan="24"><img src="https://cdn-staging.gamma.app/QWjS6fBfpt/generated-images/4hSvc35EA7JBrvPdbuIVh.jpg" saved-media-id="329uziykl27b2c8" source="image.ai-generated" background="true" image-style="figure" alt="Documentary photograph of a support operations lead standing beside a wall-mounted service-routing board with unlabeled magnetic queue markers, tracing one request path with a finger, natural daylight, three-quarter view, one focal subject, real workplace depth, naturalistic colour, no legible text, no logos" meta="{&quot;width&quot;:1440,&quot;height&quot;:2560,&quot;has_transparency&quot;:false}"></grid-item></grid></section>
<section image-layout="blank" id="zslI6bIUkX"><grid spacing="none"><grid-item id="SkZv9EfQdV"><p role="eyebrow" class="meta">01 · Purpose and success · ILLUSTRATIVE REPLACEMENT</p><h1>Why the project exists and what success means</h1><p font-size="lg" class="lede">Fragmented email, chat, and web requests create duplicate records, weak priority signals, and little visibility into queue health.</p><grid spacing="large" vertical-sizing="fill"><grid-item id="YoM26UAjS1" class="prose" colspan="24"><h3>The intended change</h3><p>The project introduces one intake and routing service for support agents, supervisors, operations leaders, and reporting teams. Each request should remain traceable from submission through assignment and resolution without replacing the underlying case-management platform.</p><hr class="rule"><h4>Deliberate non-goals</h4><p font-size="sm">Do not replace the CRM, redesign staffing levels, introduce an automated support bot, or change customer-service policy.</p><p role="caption">All thresholds are illustrative acceptance criteria, not measured company results.</p></grid-item><grid-item id="C98EPeIgzQ" colspan="36"><grid spacing="medium" vertical-sizing="fill" class="stats"><grid-item id="9KP0Txql0X" border="lg solid accent" border-sides="top" colspan="30"><display size="md" class="metric">15 min</display><h4>User outcome</h4><p font-size="sm">Acknowledgement and a valid case reference reach the requester.</p></grid-item><grid-item id="qIOGYn44EY" border="lg solid accent" border-sides="top" colspan="30"><display size="md" class="metric">≥90%</display><h4>Operational outcome</h4><p font-size="sm">Requests reach the correct queue without manual rerouting.</p></grid-item><grid-item id="tkNTt-n9oH" border="lg solid accent" border-sides="top" colspan="30"><display size="md" class="metric">95% / 2h</display><h4>Reporting outcome</h4><p font-size="sm">Dashboard updates complete within two hours.</p></grid-item><grid-item id="0uksKEbgpl" border="lg solid accent" border-sides="top" colspan="30"><display size="md" class="metric">1 owner</display><h4>Control outcome</h4><p font-size="sm">Every priority override is attributable to an authorized role.</p></grid-item></grid></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="tyoO6UTerw"><grid spacing="none"><grid-item id="Pl-XzQDc8V"><p role="eyebrow" class="meta">02 · Scope and evidence · ILLUSTRATIVE REPLACEMENT</p><h1>Scope is defined by deliverables, boundaries, and acceptance evidence</h1><p font-size="lg" class="lede">The project is four testable deliverables—not a general promise to improve support.</p><grid spacing="medium" vertical-sizing="fill"><grid-item id="qXG38g7Hw0" border="lg solid accent" border-sides="top" colspan="30"><h3>Unified intake</h3><p font-size="sm">One validated request structure for email, chat, and web submissions.</p><p font-size="sm"><b>Accepted when:</b> required fields, consent handling, duplicate checks, and acknowledgement behavior pass testing.</p></grid-item><grid-item id="JRwyPQFXWQ" border="lg solid accent" border-sides="top" colspan="30"><h3>Routing configuration</h3><p font-size="sm">Eight support categories, priority rules, queue ownership, and supervisor override controls.</p><p font-size="sm"><b>Accepted when:</b> representative scenarios route correctly.</p></grid-item><grid-item id="5r_5XObmUg" border="lg solid accent" border-sides="top" colspan="30"><h3>Operational enablement</h3><p font-size="sm">Launch runbook, agent training, escalation path, and rollback procedure.</p><p font-size="sm"><b>Accepted when:</b> designated supervisors complete a rehearsal.</p></grid-item><grid-item id="_tZYolV1Lk" border="lg solid accent" border-sides="top" colspan="30"><h3>Reporting</h3><p font-size="sm">Queue health, routing accuracy, backlog age, and override activity.</p><p font-size="sm"><b>Accepted when:</b> refresh and reconciliation thresholds are met.</p></grid-item></grid><grid divider="0.75pt" vertical-sizing="hug" class="columns"><grid-item id="0u_yyDg6Gv" class="prose" colspan="24"><h4>Outside scope</h4><p font-size="sm">CRM replacement, workforce planning, historical-data cleanup beyond 90 days, and customer-facing policy changes.</p></grid-item><grid-item id="cu1fEa4uOi" class="prose" colspan="36"><h4>Dependencies to verify</h4><p font-size="sm">Identity roles, case-management API access, analytics export capacity, approved category definitions, supervisor availability, and release-window authorization.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="6Adj24hhVW"><grid spacing="none"><grid-item id="UT3MASJgiV"><p role="eyebrow" class="meta">03 · Service path · ILLUSTRATIVE REPLACEMENT</p><h1>How a request moves through the service</h1><p font-size="lg" class="lede">Six defined outputs make failures isolatable; they are not treated as one undifferentiated service problem.</p><grid marker="number" marker-rule="true" marker-position="above" marker-align="start" marker-numbering-format="decimal-leading-zero" vertical-sizing="fill" style="--marker-gap: 0.6em;"><grid-item id="jLfrLNbX7O" colspan="20"><h3>Capture</h3><p font-size="sm">Email, chat, or web input becomes a normalized request record.</p></grid-item><grid-item id="iWjohfiyZt" colspan="20"><h3>Validate</h3><p font-size="sm">Required fields, identity, consent, and duplicate signals are checked. Invalid records enter review.</p></grid-item><grid-item id="OyVq2fw0RO" colspan="20"><h3>Classify</h3><p font-size="sm">Rules assign one of eight categories, a priority, and a confidence indicator.</p></grid-item><grid-item id="jnT1fqn4Bt" colspan="20"><h3>Route</h3><p font-size="sm">Category, region, and service hours select the queue. Authorized supervisors may override.</p></grid-item><grid-item id="-X1m6-OzrA" colspan="20"><h3>Work</h3><p font-size="sm">The case platform records assignment, response, status, and resolution.</p></grid-item><grid-item id="MKGS7RG21i" colspan="20"><h3>Observe</h3><p font-size="sm">An export supplies queue, accuracy, backlog, and override measures to the dashboard.</p></grid-item></grid><hr class="rule"><grid spacing="medium" vertical-sizing="hug" class="claim"><grid-item id="OyqPOpfDYh" colspan="14"><labels><label variant="plain" text-color="accent">RESILIENCE</label></labels></grid-item><grid-item id="k1E_uxuslJ" colspan="46"><p font-size="sm">Identity and audit logging span every stage. Reporting is asynchronous, so intake continues during export delay; failed routing leaves recoverable records in the review queue rather than discarding them.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="35HTjohv01"><grid spacing="none"><grid-item id="fWCBy9WGsg"><p role="eyebrow" class="meta">04 · Readiness evidence · ILLUSTRATIVE REPLACEMENT</p><h1>Current status: core workflow works, evidence is not yet launch-complete</h1><p font-size="lg" class="lede">This is a sample pilot-stage status, not performance reported from supplied project records.</p><table col-widths="[18,64,18]" header-row="true" borders="rows" striped="false" class="ledger"><tbody><tr><td><p>Area</p></td><td><p>Evidence and consequence</p></td><td><p>Status</p></td></tr><tr><td><p><b>Acceptance testing</b></p></td><td><p>34 of 42 scenarios passed; five are pending and three failed. Failures concern duplicate detection, overnight routing, and the analytics export.</p></td><td><p><span text-color="accent"><b>Needs attention</b></span></p></td></tr><tr><td><p><b>Configuration</b></p></td><td><p>Intake validation and all eight routing categories are configured. Baseline C-12 is the current reference.</p></td><td><p><b>Current baseline</b></p></td></tr><tr><td><p><b>Pilot</b></p></td><td><p>18 agents processed 120 controlled requests. First-pass routing met the illustrative 90% threshold, but the sample is insufficient for launch assurance.</p></td><td><p><b>Conditional</b></p></td></tr><tr><td><p><b>Operations</b></p></td><td><p>Runbook v0.6 exists; 18 of 24 designated users completed training. Rollback rehearsal remains outstanding.</p></td><td><p><b>Conditional</b></p></td></tr><tr><td><p><b>Reporting</b></p></td><td><p>The latest representative export took 4.5 hours against the two-hour target.</p></td><td><p><span text-color="accent"><b>Not accepted</b></span></p></td></tr><tr><td><p><b>Security</b></p></td><td><p>Review is complete subject to confirmation of production role assignments.</p></td><td><p><b>Conditional</b></p></td></tr></tbody></table><hr class="rule"><grid spacing="medium" vertical-sizing="hug" class="claim"><grid-item id="jU_c3QFpZ0" colspan="14"><labels><label variant="plain" text-color="accent">CRITICAL PATH</label></labels></grid-item><grid-item id="rZibwxQDpn" colspan="46"><p font-size="sm">Reporting benchmark → D-04 decision → failed-test closure → launch-readiness review. Preserve the UAT summary, pilot log, baseline C-12, runbook v0.6, and access review.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="a2O8iDxzJx"><grid spacing="none"><grid-item id="cCvI6TFXLZ"><p role="eyebrow" class="meta">05 · Decision memory · ILLUSTRATIVE REPLACEMENT</p><h1>Decisions protect the project from repeating old debates</h1><p font-size="lg" class="lede">Decision IDs remain stable when dates, owners, or evidence links are replaced.</p><table col-widths="[15,31,54]" header-row="true" borders="rows" striped="false" class="ledger"><tbody><tr><td><p>ID and state</p></td><td><p>Decision and rationale</p></td><td><p>Operating consequence</p></td></tr><tr><td><p><b>D-01</b><br>Accepted</p></td><td><p><b>Eight-category taxonomy.</b> A smaller shared taxonomy reduces ambiguous routing.</p></td><td><p>Local teams map their language to the shared categories rather than creating new queues.</p></td></tr><tr><td><p><b>D-02</b><br>Accepted</p></td><td><p><b>Supervisor-only priority overrides.</b> Restriction improves auditability.</p></td><td><p>Urgent exceptions require supervisor availability and a recorded reason.</p></td></tr><tr><td><p><b>D-03</b><br>Accepted</p></td><td><p><b>Phased rollout.</b> Two teams launch before the remaining groups.</p></td><td><p>Launch takes longer, but exposure is limited and the first wave creates a measurable rollback boundary.</p></td></tr><tr><td background-color="accent"><p><b>D-04</b><br>Open</p></td><td><p><b>Reporting readiness at launch.</b> Choose a temporary daily export or delay until the two-hour refresh target is met.</p></td><td><p>Launching preserves schedule but adds manual reconciliation; delaying protects the reporting standard but extends dual operation.</p></td></tr></tbody></table><hr class="rule"><grid divider="0.75pt" vertical-sizing="hug" class="sidehead"><grid-item id="ZYaCELJDSY" colspan="14"><labels><label variant="plain" text-color="accent">D-04 CONTROL</label></labels></grid-item><grid-item id="H3nLQZoELU" colspan="46"><p font-size="sm"><b>Accountable:</b> Product Owner. <b>Evidence owner:</b> Data Lead. <b>Next action:</b> representative-volume benchmark by T+5. <b>Decision forum:</b> T+6. The recorded decision must include the chosen consequence.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="Usa7r-wkCN"><grid spacing="none"><grid-item id="jXS2wo1OcA"><p role="eyebrow" class="meta">06 · Operating model · ILLUSTRATIVE REPLACEMENT</p><h1>Ways of working: one hierarchy of truth and explicit escalation</h1><p font-size="lg" class="lede">Durable records carry authority; chat and meetings coordinate the work but do not become the record.</p><grid spacing="large" vertical-sizing="fill"><grid-item id="c7E6y0_9yB" colspan="28"><h3>Hierarchy of truth</h3><grid divider="0.75pt" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" direction="vertical" vertical-sizing="fill" class="toc"><grid-item id="vyXg-mgtJL" padding="10pt 0"><h4>Decision log</h4><p font-size="sm">Accepted choices, rationale, consequences, and superseded decisions.</p></grid-item><grid-item id="1KEjHm3kkf" padding="10pt 0"><h4>Delivery board</h4><p font-size="sm">Owner, status, dependency, and target sequence for active work.</p></grid-item><grid-item id="0Mm1dH_9uh" padding="10pt 0"><h4>Runbook</h4><p font-size="sm">Launch, rollback, incident response, and routine operation.</p></grid-item><grid-item id="KPV2QEkfl2" padding="10pt 0"><h4>Chat and meetings</h4><p font-size="sm">Coordination only. A decision is not accepted until logged.</p></grid-item></grid></grid-item><grid-item id="6HHVbqxdvL" colspan="32"><grid divider="0.75pt" direction="vertical" vertical-sizing="fill" class="sidehead"><grid-item id="-iJ-jvjY5b" padding="10pt 0"><h4>Cadence</h4><p font-size="sm">Weekly 30-minute decision forum; twice-weekly delivery review; daily asynchronous update from T+5 through stabilization.</p></grid-item><grid-item id="jrRzMEADjt" padding="10pt 0"><h4>Recorded change control</h4><p font-size="sm">A change affecting acceptance criteria, data handling, launch sequence, or more than two business days requires a change proposal.</p></grid-item><grid-item id="wMjCb0DeBI" padding="10pt 0"><h4>Immediate escalation</h4><p font-size="sm">Escalate a production-access gap threatening launch, queue age above five minutes in rehearsal, reporting above four hours, or absence of an accountable exception authority.</p></grid-item><grid-item id="h1Iqq23Eh2" padding="10pt 0"><h4>Definition of done</h4><p font-size="sm">Evidence is attached, the runbook is updated, and the receiving role explicitly accepts the result.</p></grid-item></grid></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="sLVSBLyX7C"><grid spacing="none"><grid-item id="U2OlN2s7XN"><p role="eyebrow" class="meta">07 · Ownership and continuity · ILLUSTRATIVE REPLACEMENT</p><h1>Ownership follows outcomes, systems, and operating continuity</h1><p font-size="lg" class="lede">Replace role labels with verified people and deputies before handover acceptance.</p><table col-widths="[25,61,14]" header-row="true" borders="rows" striped="false" class="ledger"><tbody><tr><td><p>Role</p></td><td><p>Owned outcome, system, or continuity duty</p></td><td><p>Relation</p></td></tr><tr><td><p><b>Product Owner</b></p></td><td><p>Outcomes, scope, acceptance thresholds, launch authority, and D-04.</p></td><td><p>Accountable</p></td></tr><tr><td><p><b>Incoming Project Manager</b></p></td><td><p>Integrated plan, RAID record, decision forum, evidence index, and handover acceptance.</p></td><td><p>Responsible</p></td></tr><tr><td><p><b>Outgoing Project Manager</b></p></td><td><p>Context transfer, artifact reconciliation, introductions, and historical clarification through T+10.</p></td><td><p>Responsible</p></td></tr><tr><td><p><b>Technical Lead</b></p></td><td><p>Intake configuration, routing rules, integrations, release execution, and rollback.</p></td><td><p>Responsible</p></td></tr><tr><td><p><b>Operations Lead</b></p></td><td><p>Training, supervisor readiness, launch coverage, and operational adoption.</p></td><td><p>Responsible</p></td></tr><tr><td><p><b>Data Lead</b></p></td><td><p>Export benchmark, dashboard reconciliation, monitoring, and reporting fallback.</p></td><td><p>Responsible</p></td></tr><tr><td><p><b>Security Reviewer</b></p></td><td><p>Production roles, audit controls, and exception review.</p></td><td><p>Consulted</p></td></tr><tr><td><p><b>Support Supervisors</b></p></td><td><p>Workflow validation, override use, and frontline feedback.</p></td><td><p>Consulted / informed</p></td></tr></tbody></table><p role="caption" class="gloss"><b>Continuity condition —</b> Name deputies for the Product Owner, Technical Lead, and Operations Lead; provide production and reporting access to the incoming team; and transfer every recurring meeting, dashboard, and escalation duty explicitly.</p></grid-item></grid></section>
<section image-layout="blank" id="Nu3s3rSO2P"><grid spacing="none"><grid-item id="Swjs_dq36N"><p role="eyebrow" class="meta">08 · Launch confidence · ILLUSTRATIVE REPLACEMENT</p><h1>Risks, issue, and open questions converge on launch confidence</h1><p font-size="lg" class="lede">Ratings and triggers are examples to validate; I-01 is active evidence, not a future possibility.</p><table col-widths="[12,23,27,38]" header-row="true" borders="rows" striped="false" class="ledger"><tbody><tr><td><p>ID and rating</p></td><td><p>Risk or issue</p></td><td><p>Trigger</p></td><td><p>Owner response</p></td></tr><tr><td><p><b>R-01</b><br>M / H</p></td><td><p>Adoption</p></td><td><p>More than 20% manual rerouting in pilot.</p></td><td><p>Operations Lead provides category coaching and targeted rule review.</p></td></tr><tr><td><p><b>R-02</b><br>H / H</p></td><td><p>Reporting delay; drives D-04.</p></td><td><p>Refresh remains above two hours.</p></td><td><p>Data Lead benchmarks representative volume and prepares a controlled daily-export fallback.</p></td></tr><tr><td><p><b>R-03</b><br>M / M</p></td><td><p>Taxonomy drift</p></td><td><p>More than 10% uncategorized work.</p></td><td><p>Product Owner reviews changes weekly; local categories are not permitted.</p></td></tr><tr><td><p><b>R-04</b><br>L / H</p></td><td><p>API rate limiting</p></td><td><p>Queue age rises above five minutes.</p></td><td><p>Technical Lead enables throttling and controlled replay.</p></td></tr><tr><td background-color="accent"><p><b>I-01</b><br>Active</p></td><td><p>Analytics export completed in 4.5 hours.</p></td><td><p>Observed against a two-hour target.</p></td><td><p>Unresolved; benchmark and D-04 decision remain on the critical path.</p></td></tr></tbody></table><h3>Open questions that must be answered</h3><grid divider="0.75pt" vertical-sizing="hug" class="compare"><grid-item id="YlNUdBQDYK" colspan="30"><p font-size="sm"><b>Q-01 · Performance:</b> Can the export meet target at representative volume by T+5?</p></grid-item><grid-item id="5NqTF0Ayau" colspan="30"><p font-size="sm"><b>Q-02 · Fallback:</b> Is a daily export acceptable for the first rollout group?</p></grid-item><grid-item id="lmMT8u6GK8" colspan="30"><p font-size="sm"><b>Q-03 · Expansion:</b> What minimum pilot sample authorizes expansion?</p></grid-item><grid-item id="5haxxU5o5k" colspan="30"><p font-size="sm"><b>Q-04 · Authority:</b> Who approves an emergency priority override when the primary supervisor is unavailable?</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="3bAihRjnxw" card-margin-hidden="true"><grid spacing="none"><grid-item id="PR5pVjWpzE" background-color="palette-2" colspan="24"><labels><label variant="plain">09 · TRANSITION · ILLUSTRATIVE REPLACEMENT</label></labels><hr color="palette-3" thickness="md" width="xxs" class="tick"><h1>The next 30 days turn transferred knowledge into accepted ownership</h1><p font-size="sm">T+0 is the formal start of handover. Relative milestones begin only when that start is accepted.</p><spacer mode="fill"></spacer><h3>Acceptance test</h3><ul><li>Explain the project purpose.</li><li>Locate authoritative evidence.</li><li>Identify who can decide.</li><li>Describe rollback.</li><li>Name the next three actions without help.</li></ul><p font-size="sm"><b>Anything still dependent on private memory becomes a documented action, not an assumption.</b></p></grid-item><grid-item id="FQNyFc2pW-" colspan="36"><h3>30-day transfer sequence</h3><grid divider="0.75pt" direction="vertical" vertical-sizing="fill" class="sidehead"><grid-item id="ih1O94J1mm" padding="8pt 0"><h4>T+1 · Establish the transfer</h4><p font-size="sm">Confirm named owners, deputies, artifact locations, meeting invitations, and access requests.</p></grid-item><grid-item id="rhuETMSz5b" padding="8pt 0"><h4>T+3 · Reconcile the operating picture</h4><p font-size="sm">Incoming Project Manager walks the system path, reconciles the delivery board with this guide, and records contradictions.</p></grid-item><grid-item id="QDZTHMnA6M" padding="8pt 0"><h4>T+5 · Produce missing evidence</h4><p font-size="sm">Data Lead completes the representative-volume benchmark; Operations Lead completes training and rollback rehearsal.</p></grid-item><grid-item id="7J6USPZCKM" padding="8pt 0"><h4>T+6 · Decide D-04</h4><p font-size="sm">Product Owner uses benchmark evidence and records the decision and consequence.</p></grid-item><grid-item id="Pn7tYFZSR9" padding="8pt 0"><h4>T+10 · Accept or extend handover</h4><p font-size="sm">Review failed tests, production roles, fallback readiness, and launch authority.</p></grid-item><grid-item id="NgoGb4hPaW" padding="8pt 0"><h4>T+15 · Execute the first rollout</h4><p font-size="sm">Proceed only when the agreed entry criteria are met.</p></grid-item><grid-item id="iJ72wyF2BS" padding="8pt 0"><h4>T+30 · Review operating stability</h4><p font-size="sm">Assess adoption, unresolved risks, and whether temporary controls can be retired.</p></grid-item></grid></grid-item></grid></section>