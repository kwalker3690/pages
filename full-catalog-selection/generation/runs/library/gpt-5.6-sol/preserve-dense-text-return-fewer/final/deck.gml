<HEAD><style>/* Readable Detail — page sheet. The typeset technical handbook: hairline rules group,
   weight and column position make hierarchy, one accent means "read this first".
   Every colour routes through theme vars; classes carry shape and rhythm only. */

.gml-card {
  --rule: var(--divider-color);
  --hairline: 0.75pt;
  /* A figure caption clears the image crop by a full line of air (renderer knob). */
  --caption-hug-gap: 15pt;
}

/* ── Signature move 3: the topic rule. Every seam in the deck is ONE hairline in the
   theme's divider colour. Grids wearing these register classes draw designed seams. ── */
.sidehead, .columns, .toc, .faq, .steps, .checks, .roles, .pillars, .cover-meta, .stats, .compare {
  --grid-divider-color: var(--rule);
  --grid-divider-width: var(--hairline);
}
.rule.gml-divider { --divider-color: var(--rule); --divider-thickness: var(--hairline); border-radius: 0; }

/* ── Signature move 8: the short accent tick — cover, closing, dark act breaks only. ── */
.tick.gml-divider { --divider-color: var(--accent-color); --divider-thickness: 2pt; border-radius: 0; }
.tick.gml-divider .gml-divider__rule { width: 40pt; margin-inline-start: 0; border-radius: 0; }

/* ── Signature move 1: the side-head. Label column beside a reading column, a hairline
   above each group; the text clears the seam by the seam inset. ── */
.sidehead { --grid-seam-inset: 14pt; }
.sidehead .gml-grid-cell__content { --block-gap: 8pt; }

/* ── Signature move 2: the lede — one 17pt opening sentence, held to a reading measure. ── */
.lede.gml-paragraph { max-width: 600pt; }

/* ── Signature move 4: the running index — "02 · Receiving and release", one per body card. ── */
.meta.gml-paragraph { font-variant-numeric: tabular-nums; margin-block-end: calc(var(--block-gap) * 0.6); }

/* ── Signature move 5: the figure caption — "Figure 4 — a full sentence." (lead in bold serif) ── */
.gloss.gml-paragraph { max-width: 560pt; margin-block-start: calc(var(--block-gap) * 0.5); }

/* ── Signature move 6: the ledger table — plate-tinted sans header row, hairline row rules,
   no vertical rules, numbers right-aligned in tabular figures. ── */
.ledger {
  --table-border-width: var(--hairline);
  --table-border-color: var(--rule);
  --table-header-bg: var(--surface-color);
  --table-header-color: var(--body-color-muted);
  --table-header-weight: 600;
  --table-header-font: var(--heading-font);
  --table-cell-padding: 8pt 12pt 8pt 8pt;
  --table-radius: 0;
}
.ledger .gml-table__cell { font-size: calc(13 * var(--type-anchor, 1pt)); }
.ledger .gml-table__row[data-header] .gml-table__cell { font-size: calc(11 * var(--type-anchor, 1pt)); letter-spacing: 0.01em; }
.ledger .gml-table__cell.num { text-align: end; font-variant-numeric: tabular-nums; }
.ledger .gml-table__row:last-child .gml-table__cell { border-bottom: var(--table-border-width) solid var(--table-border-color); }

/* ── Signature move 7: the claim row — a small caps label beside one sentence. ── */
.claim .gml-label-group { --label-pad-inline: 0; --label-pad-block: 0; }
.claim .gml-grid-cell__content { --block-gap: 4pt; }

/* Cover meta ledger: label/value cells separated by hairline seams (cover-meta class). */
.cover-meta { --grid-seam-inset: 16pt; }
.cover-meta .gml-grid-cell__content { --block-gap: 4pt; }

/* Stat figures: tabular numerals on display nodes. */
.metric { font-variant-numeric: tabular-nums; }
.stats { --grid-seam-inset: 16pt; --cell-decor-color: var(--accent-color); }
.stats .gml-grid-cell__content { --block-gap: 6pt; }

/* Reading columns (two- and three-column text): a tighter paragraph beat inside a column
   than between groups, and a hairline seam between columns. */
.columns { --grid-seam-inset: 22pt; }
.prose .gml-grid-cell__content { --block-gap: 10pt; }

/* Marker numerals and glyphs (agenda, procedure, checklist) set in the heading sans, tabular. */
.toc .gml-grid-cell__marker, .steps .gml-grid-cell__marker, .checks .gml-grid-cell__marker { font-family: var(--heading-font); font-variant-numeric: tabular-nums; }

/* Agenda contents ledger: muted numerals in a fixed gutter. */
.toc { --marker-color: var(--body-color-muted); --marker-inline-size: 36pt; --marker-gap: 14pt; --grid-seam-inset: 14pt; }

/* Numbered procedure: accent numerals inline-left, editorial rows on hairline seams. */
.steps { --marker-color: var(--accent-color); --marker-font-size: 22pt; --marker-font-weight: 700; --marker-inline-size: 44pt; --marker-gap: 16pt; --grid-seam-inset: 14pt; }
.steps .gml-grid-cell__content { --block-gap: 8pt; }

/* Checklist: accent check marks (symbol markers) in the gutter, generous row air. */
.checks { --marker-color: var(--accent-color); --marker-font-weight: 700; --marker-inline-size: 22pt; --marker-gap: 12pt; --grid-seam-inset: 16pt; }

/* FAQ ledger: question column beside answer column, hairline above each pair. */
.faq { --grid-seam-inset: 14pt; }
.faq .gml-grid-cell__content { --block-gap: 6pt; }

/* Icon-led registers: ink glyphs sized to their text, hairline seams. */
.roles { --marker-color: var(--heading-color); --marker-inline-size: 30pt; --marker-gap: 14pt; --grid-seam-inset: 14pt; }
.pillars { --marker-color: var(--heading-color); --grid-seam-inset: 18pt; }
.pillars .gml-grid-cell__content { --block-gap: 8pt; }

/* Comparison columns: peer cells on hairline seams, a tighter beat inside each. */
.compare { --grid-seam-inset: 18pt; }
.compare .gml-grid-cell__content { --block-gap: 8pt; }

/* Figure plates: square corners and a hairline keyline around in-flow figures. */
.plate .gml-figure__img { border: var(--hairline) solid var(--rule); border-radius: 0; }
.plate.gml-grid-cell { --cell-radius: 0; }

/* Evidence cells (chart + gloss) keep the caption close to the plot. */
.evidence .gml-grid-cell__content { --block-gap: 8pt; }

/* Pull quote: a 2pt accent bar, the one accent moment on that card. */
.quote.gml-blockquote { padding-inline-start: 22pt; }
.quote.gml-blockquote > .gml-blockquote__bar { width: 2pt; border-radius: 0; background: var(--accent-color); }

/* Dark act breaks and the closing (root cell painted ink): rules and ticks lift to the
   lightened accent so they read on the ground. */
.act { --rule: var(--body-color-muted); }
.act .tick.gml-divider { --divider-color: var(--palette-3); }
.act .gml-grid-cell__content { --block-gap: 14pt; }

/* Statement: one display-scale claim held to a measure. */
.statement .gml-title { max-width: 760pt; }

/* Running footer: the page number in the sans, tabular. */
.gml-card__footer { font-family: var(--heading-font); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; color: var(--body-color-muted); }</style></HEAD>
<section image-layout="blank" id="RbJ3k8DRt0" card-margin-hidden="true"><grid spacing="none"><grid-item id="c9Kcqxx7KP" background-color="palette-2" padding="30pt 24pt 12pt" colspan="22"><labels><label variant="plain" text-color="palette-3">PROJECT HANDOVER FIELD GUIDE</label></labels><h2>Customer Support Intake Redesign</h2><p font-size="15pt"><b>Illustrative replacement.</b> No project records were supplied. Validate every status, role, metric, artifact version, and milestone before operational use.</p><table col-widths="[34,66]" header-col="true" borders="rows" striped="false" style="--table-cell-padding: 7pt 4pt;"><tbody><tr><td><p font-size="14pt"><b>Current phase</b></p></td><td><p font-size="15pt">Pilot validation and launch preparation</p></td></tr><tr><td><p font-size="14pt"><b>Condition</b></p></td><td><p font-size="15pt">Workflow works; reporting remains unresolved</p></td></tr><tr><td><p font-size="14pt"><b>Transition target</b></p></td><td><p font-size="15pt">Incoming ownership accepted by T+10 business days</p></td></tr></tbody></table></grid-item><grid-item id="6yCpfjXd1N" padding="30pt 32pt 12pt" colspan="38"><display size="md" font-size="34pt">A handover is complete when work moves without memory</display><p font-size="16pt" class="lede">This guide connects operating evidence to the people, decisions, and actions needed to continue the work.</p><hr color="accent" thickness="md" width="xxs" class="tick"><h3>Critical-path relay</h3><grid divider="0.75pt" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" vertical-sizing="hug" class="steps"><grid-item id="AUaqeTXOxz" padding="9pt 10pt" colspan="30"><h4>Evidence</h4><p font-size="15pt">Observed export: 4.5 hours against a two-hour target.</p></grid-item><grid-item id="syg7Lx9nzA" padding="9pt 10pt" colspan="30"><h4>Benchmark</h4><p font-size="15pt"><b>Data Lead · T+5</b> — Test representative volume and document the fallback.</p></grid-item><grid-item id="7A2EC9tOs9" padding="9pt 10pt" colspan="30"><h4>Decision D-04</h4><p font-size="15pt"><b>Product Owner · T+6</b> — Launch with a controlled daily export or delay.</p></grid-item><grid-item id="3UDQvoGyZP" padding="9pt 10pt" colspan="30"><h4>Acceptance</h4><p font-size="15pt"><b>Incoming Project Manager · T+10</b> — Accept ownership or extend the handover with named actions.</p></grid-item></grid><p role="caption" class="gloss">Decision detail: card 6 · ownership: card 8 · transition sequence: card 10.</p></grid-item></grid></section>
<section image-layout="blank" id="zslI6bIUkX"><grid spacing="none"><grid-item id="HDiZw-dBga" padding="36pt 44pt 18pt"><p role="eyebrow" class="meta">01 · Purpose and success · ILLUSTRATIVE REPLACEMENT</p><h1>Success is measurable at four handoffs</h1><p font-size="17pt" class="lede">Fragmented email, chat, and web requests create duplicate records, weak priority signals, and poor queue visibility.</p><grid spacing="large"><grid-item id="Nbt4-LP3_b" class="prose" colspan="22"><h3>The intended change</h3><p font-size="16pt">Introduce one intake and routing service for agents, supervisors, operations leaders, and reporting teams. Keep every request traceable from submission through assignment and resolution; retain the case-management platform.</p><hr class="rule"><h4>Deliberate non-goals</h4><p font-size="16pt">Do not replace the CRM, redesign staffing, add an automated support bot, or change customer-service policy.</p><p role="caption">Thresholds are illustrative acceptance criteria, not measured company results.</p></grid-item><grid-item id="AIoJJITB3f" colspan="38"><grid spacing="medium" vertical-sizing="hug" class="stats"><grid-item id="oZ90wB1lVU" padding="10pt 12pt 8pt" border="lg solid accent" border-sides="top" colspan="30"><display size="md" font-size="36pt" class="metric">15 min</display><h4>User outcome</h4><p font-size="15pt">Requester receives acknowledgement and a valid case reference.</p></grid-item><grid-item id="iWU76LLfqF" padding="10pt 12pt 8pt" border="lg solid accent" border-sides="top" colspan="30"><display size="md" font-size="36pt" class="metric">≥90%</display><h4>Operational outcome</h4><p font-size="15pt">Correct queue assignment, without manual rerouting.</p></grid-item><grid-item id="HDn5yf7gik" padding="10pt 12pt 8pt" border="lg solid accent" border-sides="top" colspan="30"><display size="md" font-size="36pt" class="metric">95% / 2h</display><h4>Reporting outcome</h4><p font-size="15pt">Dashboard refresh completes within two hours.</p></grid-item><grid-item id="5eTg7LXMGX" padding="10pt 12pt 8pt" border="lg solid accent" border-sides="top" colspan="30"><display size="md" font-size="36pt" class="metric">1 owner</display><h4>Control outcome</h4><p font-size="15pt">Each priority override traces to one authorized role.</p></grid-item></grid></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="tyoO6UTerw"><grid spacing="none"><grid-item id="foFeHDDwEl"><p role="eyebrow" class="meta">02 · Scope and evidence · ILLUSTRATIVE REPLACEMENT</p><h1>Scope is four deliverables with explicit boundaries</h1><p font-size="17pt" class="lede">Acceptance is tied to evidence—not to a general promise to improve support.</p><table col-widths="[24,35,41]" header-row="true" borders="rows" striped="false" class="ledger" style="--table-cell-padding: 3pt 8pt;"><tbody><tr><td><p font-size="15pt">Deliverable</p></td><td><p font-size="15pt">Included output</p></td><td><p font-size="15pt">Acceptance evidence</p></td></tr><tr><td><p font-size="15pt"><b>Unified intake</b></p></td><td><p font-size="15pt">Validated structure for email, chat, and web.</p></td><td><p font-size="15pt">Required fields, consent, duplicate checks, and acknowledgement pass.</p></td></tr><tr><td><p font-size="15pt"><b>Routing configuration</b></p></td><td><p font-size="15pt">Eight categories; priority rules, queue ownership, and overrides.</p></td><td><p font-size="15pt">Representative scenarios reach the correct queue.</p></td></tr><tr><td><p font-size="15pt"><b>Operational enablement</b></p></td><td><p font-size="15pt">Runbook, training, escalation path, and rollback.</p></td><td><p font-size="15pt">Designated supervisors complete a rehearsal.</p></td></tr><tr><td><p font-size="15pt"><b>Reporting</b></p></td><td><p font-size="15pt">Queue health, accuracy, backlog age, and overrides.</p></td><td><p font-size="15pt">Refresh and reconciliation thresholds are met.</p></td></tr></tbody></table><grid divider="0.75pt" vertical-sizing="hug" class="columns"><grid-item id="A64fGVGodb" class="prose" colspan="24"><h4>Outside scope</h4><p font-size="15pt">CRM replacement; staffing design; &gt;90-day cleanup; customer-facing policy changes.</p></grid-item><grid-item id="5VUSl8vDqH" class="prose" colspan="36"><h4>Dependencies to verify</h4><p font-size="15pt">Identity roles, API access, export capacity, category approval, supervisor availability, and release authorization.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="6Adj24hhVW"><grid spacing="none"><grid-item id="SYXXnuQt6e"><p role="eyebrow" class="meta">03 · Service path · ILLUSTRATIVE REPLACEMENT</p><h1>One request becomes six controlled outputs</h1><p font-size="17pt" class="lede">The path isolates failures while keeping invalid or delayed records recoverable.</p><grid marker="number" marker-size="small" marker-style="subtle" marker-shape="chevron" marker-position="above" marker-align="center" marker-fill="true" marker-numbering-format="decimal-leading-zero" spacing="none" class="steps" style="--marker-chip-padding: 0.35em; --marker-font-size: 16pt;"><grid-item id="_lvjFDGEdK" padding="6pt 8pt 8pt" colspan="10"><h4>Capture</h4><p font-size="15pt">Normalize email, chat, and web intake.</p></grid-item><grid-item id="Rd5QAu1bso" padding="6pt 8pt 8pt" colspan="10"><h4>Validate</h4><p font-size="15pt">Check fields, identity, consent, and duplicates.</p></grid-item><grid-item id="eEZTwNmKTU" padding="6pt 8pt 8pt" colspan="10"><h4>Classify</h4><p font-size="15pt">Assign category, priority, and confidence.</p></grid-item><grid-item id="WZF4M7c0xY" padding="6pt 8pt 8pt" colspan="10"><h4>Route</h4><p font-size="15pt">Select the queue; record overrides.</p></grid-item><grid-item id="3GRIgTdkA6" padding="6pt 8pt 8pt" colspan="10"><h4>Work</h4><p font-size="15pt">Track assignment to resolution.</p></grid-item><grid-item id="Nua-SrcpBc" padding="6pt 8pt 8pt" colspan="10"><h4>Observe</h4><p font-size="15pt">Export queue, accuracy, backlog, and overrides.</p></grid-item></grid><grid spacing="medium" vertical-sizing="hug"><grid-item id="Lr0nYjOS2m" background-color="surface" cell-decor="side-line" padding="14pt 18pt" colspan="30"><labels><label variant="plain">RECOVERABLE REVIEW LOOP</label></labels><p font-size="16pt"><b>Validation/routing failure → review queue → corrected record → reclassify.</b> Nothing is discarded.</p></grid-item><grid-item id="AlxEIXkZjE" background-color="surface" cell-decor="side-line" padding="14pt 18pt" colspan="30"><labels><label variant="plain">ASYNCHRONOUS REPORTING</label></labels><p font-size="16pt"><b>Work → delayed export → dashboard.</b> Intake continues; identity and audit logging span every stage.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="35HTjohv01"><grid spacing="none"><grid-item id="AnhEjF6wV4"><p role="eyebrow" class="meta">04 · Readiness evidence · ILLUSTRATIVE REPLACEMENT</p><h1>Workflow works; launch evidence does not</h1><p font-size="17pt" class="lede">Illustrative pilot-stage status—not performance from supplied project records.</p><table col-widths="[20,58,22]" header-row="true" borders="rows" striped="false" class="ledger" style="--table-cell-padding: 3pt 8pt;"><tbody><tr><td><p font-size="15pt">Area</p></td><td><p font-size="15pt">Evidence and consequence</p></td><td><p font-size="15pt">Status</p></td></tr><tr><td><p font-size="15pt"><b>Acceptance testing</b></p></td><td><p font-size="15pt">34 of 42 passed; five pending and three failed—duplicate detection, overnight routing, and export.</p></td><td><p font-size="15pt"><span text-color="accent"><b>Needs attention</b></span></p></td></tr><tr><td><p font-size="15pt"><b>Configuration</b></p></td><td><p font-size="15pt">All eight routing categories are configured; baseline C-12 is current.</p></td><td><p font-size="15pt"><b>Baseline</b></p></td></tr><tr><td><p font-size="15pt"><b>Pilot</b></p></td><td><p font-size="15pt">18 agents processed 120 controlled requests and met the illustrative 90% threshold; the sample is not launch assurance.</p></td><td><p font-size="15pt"><b>Conditional</b></p></td></tr><tr><td><p font-size="15pt"><b>Operations</b></p></td><td><p font-size="15pt">Runbook v0.6 exists; 18 of 24 users trained; rollback rehearsal remains open.</p></td><td><p font-size="15pt"><b>Conditional</b></p></td></tr><tr><td><p font-size="15pt"><b>Reporting</b></p></td><td><p font-size="15pt">Representative export took 4.5 hours against the two-hour target.</p></td><td><p font-size="15pt"><span text-color="accent"><b>Not accepted</b></span></p></td></tr><tr><td><p font-size="15pt"><b>Security</b></p></td><td><p font-size="15pt">Review is complete, subject to production role confirmation.</p></td><td><p font-size="15pt"><b>Conditional</b></p></td></tr></tbody></table><grid spacing="medium" vertical-sizing="hug" class="claim"><grid-item id="Hvvv0lXRr9" colspan="14"><labels><label variant="plain" text-color="accent">CRITICAL PATH</label></labels></grid-item><grid-item id="sX5upTlEy1" colspan="46"><p font-size="16pt">Benchmark → D-04 → failed-test closure → launch review. Preserve the UAT summary, pilot log, C-12, runbook v0.6, and access review.</p></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="a2O8iDxzJx"><grid spacing="none"><grid-item id="XP53e2vOy0"><p role="eyebrow" class="meta">05 · Decision memory · ILLUSTRATIVE REPLACEMENT</p><h1>Decision memory prevents repeat debate</h1><p font-size="17pt">Stable IDs preserve rationale and consequences when owners, dates, or evidence links change.</p><table col-widths="[15,36,49]" header-row="true" borders="rows" striped="false" class="ledger" style="--table-cell-padding: 5pt 8pt;"><tbody><tr><td><p font-size="16pt">ID and state</p></td><td><p font-size="16pt">Decision and rationale</p></td><td><p font-size="16pt">Operating consequence</p></td></tr><tr><td><p font-size="16pt"><b>D-01</b><br>Accepted</p></td><td><p font-size="16pt"><b>Eight-category taxonomy.</b> A shared set reduces ambiguity.</p></td><td><p font-size="16pt">Local language maps to shared categories; teams do not create new queues.</p></td></tr><tr><td><p font-size="16pt"><b>D-02</b><br>Accepted</p></td><td><p font-size="16pt"><b>Supervisor-only priority overrides.</b> Restriction improves auditability.</p></td><td><p font-size="16pt">Urgent exceptions require an available supervisor and recorded reason.</p></td></tr><tr><td><p font-size="16pt"><b>D-03</b><br>Accepted</p></td><td><p font-size="16pt"><b>Phased rollout.</b> Two teams launch first.</p></td><td><p font-size="16pt">Exposure is limited and wave one creates a measurable rollback boundary.</p></td></tr><tr><td background-color="accent"><p font-size="16pt"><b>D-04</b><br>Open</p></td><td><p font-size="16pt"><b>Reporting readiness at launch.</b> Choose a temporary daily export or delay to protect the two-hour target.</p></td><td><p font-size="16pt">Launch adds manual reconciliation; delay protects the standard but extends dual operation.</p></td></tr><tr><td colspan="3" background-color="surface"><p font-size="16pt"><b>D-04 CONTROL</b> · <b>Accountable:</b> Product Owner · <b>Evidence:</b> Data Lead · <b>Benchmark:</b> T+5 · <b>Decision forum:</b> T+6 · Record the selected consequence.</p></td></tr></tbody></table></grid-item></grid></section>
<section image-layout="blank" id="Usa7r-wkCN"><grid spacing="none"><grid-item id="11_dXyda6S"><p role="eyebrow" class="meta">06 · Operating model · ILLUSTRATIVE REPLACEMENT</p><h1>One source of truth; explicit escalation</h1><p font-size="16pt" class="lede">Durable records carry authority; chat and meetings coordinate work but do not become the record.</p><table col-widths="[42,58]" header-row="true" borders="rows" striped="false" style="--table-cell-padding: 5pt 10pt;"><tbody><tr><td><p>Hierarchy of truth</p></td><td><p>Operating rules</p></td></tr><tr><td valign="top"><grid divider="0.75pt" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" direction="vertical" vertical-sizing="hug" class="toc"><grid-item id="R8e3JFpres" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Decision log</span></b> — Accepted choices, rationale, consequences, and superseded decisions.</p></grid-item><grid-item id="re2Avowe-Q" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Delivery board</span></b> — Owner, status, dependency, and target sequence for active work.</p></grid-item><grid-item id="_ljWIGaNm2" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Runbook</span></b> — Launch, rollback, incident response, and routine operation.</p></grid-item><grid-item id="D9SCdk2Qlq" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Chat and meetings</span></b> — Coordination only; a decision is accepted only when logged.</p></grid-item></grid></td><td valign="top"><grid divider="0.75pt" direction="vertical" vertical-sizing="hug" class="sidehead"><grid-item id="s4P8wuFg5V" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Cadence</span></b> — Weekly decision forum; twice-weekly delivery review; daily asynchronous update from T+5 through stabilization.</p></grid-item><grid-item id="ddE6MdacHb" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Recorded change control</span></b> — Changes to acceptance, data handling, launch sequence, or more than two business days require a proposal.</p></grid-item><grid-item id="IW2Fn8pv3B" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Immediate escalation</span></b> — Escalate launch-threatening access gaps, queue age above five minutes, reporting above four hours, or missing exception authority. Two hours is the reporting warning and acceptance threshold.</p></grid-item><grid-item id="G5QfyiLJ9j" padding="5pt 0"><p font-size="14pt"><b><span font-id="Fira Sans" font-family="Fira Sans">Definition of done</span></b> — Evidence is attached, the runbook is updated, and the receiving role explicitly accepts the result.</p></grid-item></grid></td></tr></tbody></table></grid-item></grid></section>
<section image-layout="blank" id="sLVSBLyX7C"><grid spacing="none"><grid-item id="0njnW5OUrt"><p role="eyebrow" class="meta">07 · Ownership and continuity · ILLUSTRATIVE REPLACEMENT</p><h1>Ownership follows the outcome—not the org chart</h1><p font-size="16pt" class="lede">Replace role labels with verified owners and deputies before accepting handover.</p><table col-widths="[1,1]" header-row="true" borders="rows" striped="false" style="--table-cell-padding: 5pt 12pt;"><tbody><tr><td><p>Transition spine</p></td><td><p>Service continuity</p></td></tr><tr><td><p font-size="14pt"><b>Product Owner · Accountable</b> — Owns outcomes, scope, acceptance thresholds, launch authority, and D-04.</p></td><td><p font-size="14pt"><b>Technical Lead · Responsible</b> — Owns configuration, routing, integrations, release execution, and rollback.</p></td></tr><tr><td><p font-size="14pt"><b>Incoming Project Manager · Responsible</b> — Owns the integrated plan, RAID record, evidence index, forums, and handover acceptance.</p></td><td><p font-size="14pt"><b>Operations Lead · Responsible</b> — Owns training, supervisor readiness, launch coverage, and adoption.</p></td></tr><tr><td><p font-size="14pt"><b>Outgoing Project Manager · Responsible</b> — Transfers context, reconciles artifacts, makes introductions, and clarifies history through T+10.</p></td><td><p font-size="14pt"><b>Security Reviewer · Consulted</b> — Confirms production roles, audit controls, and exception review.</p></td></tr><tr><td><p font-size="14pt"><b>Data Lead · Responsible</b> — Owns the export benchmark, reconciliation, monitoring, and reporting fallback for D-04.</p></td><td><p font-size="14pt"><b>Support Supervisors · Consulted / informed</b> — Validate workflow behavior, override use, and frontline feedback.</p></td></tr></tbody></table><p role="caption"><b>Continuity condition —</b> Name deputies for the Product Owner, Technical Lead, and Operations Lead; transfer production and reporting access, meetings, dashboards, and escalation duties.</p></grid-item></grid></section>
<section image-layout="blank" id="Nu3s3rSO2P"><grid spacing="none"><grid-item id="BidVk1SW9v"><p role="eyebrow" class="meta">08 · Launch confidence · ILLUSTRATIVE REPLACEMENT</p><h1>One issue and four answers gate launch</h1><p font-size="16pt" class="lede">Validate illustrative ratings/triggers; I-01 is observed, not hypothetical.</p><grid spacing="medium" vertical-sizing="hug"><grid-item id="HCjEy9u-Pc" colspan="34"><h3>Risks and active issue</h3><table col-widths="[31,69]" header-row="true" borders="rows" striped="false" class="ledger" style="--table-cell-padding: 3pt 7pt;"><tbody><tr><td><p font-size="16pt">Risk / issue</p></td><td><p font-size="16pt">Trigger → response</p></td></tr><tr><td valign="middle"><p font-size="16pt"><b>R-01</b> · Adoption · M/H</p></td><td valign="middle"><p font-size="16pt">&gt;20% manual rerouting → Operations coaches categorization and reviews rules.</p></td></tr><tr><td valign="middle"><p font-size="16pt"><b>R-02</b> · Reporting delay · H/H</p></td><td valign="middle"><p font-size="16pt">Warning &gt;2 hours → Data benchmarks volume and prepares daily-export fallback.</p></td></tr><tr><td valign="middle"><p font-size="16pt"><b>R-03</b> · Taxonomy drift · M/M</p></td><td valign="middle"><p font-size="16pt">&gt;10% uncategorized → Product Owner reviews weekly; no local categories.</p></td></tr><tr><td valign="middle"><p font-size="16pt"><b>R-04</b> · API rate limit · L/H</p></td><td valign="middle"><p font-size="16pt">Queue age &gt;5 minutes → Technical Lead throttles and replays.</p></td></tr><tr><td background-color="accent" valign="middle"><p font-size="16pt"><b>I-01</b> · Active issue<br>Export: 4.5 hours</p></td><td valign="middle"><p font-size="16pt">Observed against 2 hours; benchmark and D-04 remain critical-path work.</p></td></tr></tbody></table></grid-item><grid-item id="eSlc_iUt-3" colspan="26"><h3>Questions to close</h3><grid divider="0.75pt" vertical-sizing="hug" class="sidehead"><grid-item id="JUjqERbK4y" padding="7pt 8pt" colspan="30"><p font-size="16pt"><b>Q-01 · Export performance</b><br><b>Data Lead · T+5.</b> Benchmark volume → gate D-04.</p></grid-item><grid-item id="wDH9x4j-8x" padding="7pt 8pt" colspan="30"><p font-size="16pt"><b>Q-02 · Daily fallback</b><br><b>Product Owner · T+6.</b> Decide: launch or extend dual operation.</p></grid-item><grid-item id="DsrWKhx0mT" padding="7pt 8pt" colspan="30"><p font-size="16pt"><b>Q-03 · Expansion sample</b><br><b>Product Owner · before T+15.</b> Set minimum sample → gate rollout expansion.</p></grid-item><grid-item id="WECZ0L1Cb9" padding="7pt 8pt" colspan="30"><p font-size="16pt"><b>Q-04 · Emergency override</b><br><b>Operations Lead · by T+10.</b> Name deputy or authority → protect continuity.</p></grid-item></grid></grid-item></grid></grid-item></grid></section>
<section image-layout="blank" id="3bAihRjnxw" card-margin-hidden="true"><grid spacing="none"><grid-item id="3LQ2dyTKeM" background-color="palette-2" padding="38pt 28pt" colspan="23"><p role="eyebrow"><span text-color="palette-3">09 · TRANSITION · ILLUSTRATIVE REPLACEMENT</span></p><hr color="palette-3" thickness="md" width="xxs" class="tick"><h1>Ownership is accepted, not assumed</h1><p font-size="16pt">T+0 is the formally accepted start of handover. Relative milestones begin only then.</p><h3>Acceptance test</h3><ul><li>Explain the project purpose.</li><li>Locate authoritative evidence.</li><li>Identify who can decide.</li><li>Describe rollback.</li><li>Name the next three actions unaided.</li></ul><p font-size="16pt"><b>If any answer still depends on private memory, handover is not accepted.</b></p></grid-item><grid-item id="7_F3qnSIW-" padding="38pt 40pt" colspan="37"><h2>30-day transfer sequence</h2><table col-widths="[14,86]" borders="rows" striped="false" class="ledger" style="--table-cell-padding: 6pt 8pt;"><tbody><tr><td><p font-size="16pt"><b>T+1</b></p></td><td><p font-size="16pt"><b>Establish the transfer.</b> Confirm owners, deputies, artifact locations, meetings, and access requests.</p></td></tr><tr><td><p font-size="16pt"><b>T+3</b></p></td><td><p font-size="16pt"><b>Reconcile the operating picture.</b> Walk the service path, compare the board with this guide, and log contradictions.</p></td></tr><tr><td><p font-size="16pt"><b>T+5</b></p></td><td><p font-size="16pt"><b>Produce missing evidence.</b> Data completes the benchmark; Operations completes training and rollback rehearsal.</p></td></tr><tr><td><p font-size="16pt"><b>T+6</b></p></td><td><p font-size="16pt"><b>Decide D-04.</b> Product Owner records the selected consequence.</p></td></tr><tr><td><p font-size="16pt"><b>T+10</b></p></td><td><p font-size="16pt"><b>Accept or extend handover.</b> Review failed tests, production roles, fallback readiness, and launch authority.</p></td></tr><tr><td><p font-size="16pt"><b>T+15</b></p></td><td><p font-size="16pt"><b>Execute the first rollout.</b> Proceed only when agreed entry criteria are met.</p></td></tr><tr><td><p font-size="16pt"><b>T+30</b></p></td><td><p font-size="16pt"><b>Review operating stability.</b> Assess adoption, unresolved risks, and whether temporary controls can retire.</p></td></tr></tbody></table></grid-item></grid></section>