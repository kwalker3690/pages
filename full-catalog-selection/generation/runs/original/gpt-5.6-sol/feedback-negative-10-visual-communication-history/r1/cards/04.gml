<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Era 02 · Coded state</p>
      <h2>The document joins a network</h2>
      <p>A page becomes a maintained, networked version rather than a distributed finished copy.</p>
      <smart-layout orientation="horizontal" two-sided="true" variant="minimalTimeline">
        <smart-layout-item>
          <h4>1989 · The proposal</h4>
          <p>Tim Berners-Lee proposes the Web at CERN.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>30 April 1993 · Public domain</h4>
          <p>CERN makes Web software freely available.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>The networked page</h4>
          <p>Addressable, linkable, updateable, and connected to user action.</p>
        </smart-layout-item>
      </smart-layout>
      <grid spacing="small" vertical-sizing="hug">
        <grid-item colspan="15" cell-style="subtle"><h4>Addressable</h4></grid-item>
        <grid-item colspan="15" cell-style="subtle"><h4>Linkable</h4></grid-item>
        <grid-item colspan="15" cell-style="subtle"><h4>Updateable</h4></grid-item>
        <grid-item colspan="15" cell-style="subtle"><h4>Responsive</h4></grid-item>
      </grid>
      <p role="caption">Source: <a href="https://home.cern/science/computing/the-birth-of-the-web/">CERN, “The birth of the Web”</a></p>
    </grid-item>
  </grid>
</section>