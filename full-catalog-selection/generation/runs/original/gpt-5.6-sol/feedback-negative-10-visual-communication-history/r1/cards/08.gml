<section background-color="heading">
  <grid spacing="medium">
    <grid-item colspan="25">
      <p role="eyebrow">Studio method · Five questions</p>
      <h1 font-size="40pt">Design the conditions, not only the artifact</h1>
      <p font-size="lg">Read the medium by tracing what it permits, distributes, conceals, and asks the audience to become.</p>
      <spacer mode="fill"/>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="surface" padding="16pt 18pt">
          <p role="eyebrow">Studio prompt</p>
          <p>Translate one message across print, interactive, and generative forms. Keep intent constant; document how roles change.</p>
        </grid-item>
      </grid>
    </grid-item>
    <grid-item colspan="35" vertical-align="center">
      <grid direction="vertical" divider="sm palette-5" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" marker-style="solid" marker-shape="circle" style="--marker-inline-size:32pt; --marker-gap:14pt">
        <grid-item padding="12pt 0">
          <h4>What is fixed, and what can vary?</h4>
        </grid-item>
        <grid-item padding="12pt 0">
          <h4>Who can make, publish, revise, and respond?</h4>
        </grid-item>
        <grid-item padding="12pt 0">
          <h4>How does the work travel?</h4>
        </grid-item>
        <grid-item padding="12pt 0">
          <h4>Where are decisions visible or hidden?</h4>
        </grid-item>
        <grid-item padding="12pt 0">
          <h4>What does the interface ask the audience to become?</h4>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>