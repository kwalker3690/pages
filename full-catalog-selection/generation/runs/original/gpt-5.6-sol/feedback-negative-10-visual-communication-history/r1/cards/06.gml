<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Era 03 · Generated variation</p>
      <h2>Computational intelligence makes the output variable</h2>
      <p>The designer increasingly specifies a space of possible outputs rather than one resolved artifact.</p>
      <smart-layout cell-size="10" variant="cycle">
        <smart-layout-item><h4>Intent + constraints</h4></smart-layout-item>
        <smart-layout-item><h4>Data, rules, or prompt</h4></smart-layout-item>
        <smart-layout-item><h4>Model computation</h4></smart-layout-item>
        <smart-layout-item><h4>Output</h4></smart-layout-item>
        <smart-layout-item><h4>Human judgment</h4></smart-layout-item>
        <smart-layout-item><h4>Revision</h4></smart-layout-item>
      </smart-layout>
      <grid spacing="medium" vertical-sizing="hug">
        <grid-item colspan="30" cell-style="subtle">
          <h4>What scales</h4>
          <p>Variation, adaptation, and repeated synthesis across contexts.</p>
        </grid-item>
        <grid-item colspan="30" background-color="accent">
          <h4>What becomes design work</h4>
          <p>Provenance, opacity, bias, evaluation, and the conditions for responsible revision.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>