<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Era 01 · Fixed instance</p>
      <h2>Print stabilizes space</h2>
      <grid spacing="medium">
        <grid-item colspan="35">
          <custom-code>
            <style>
              .forme-study { width: 100%; font-family: var(--body-font); color: var(--body-color); }
              .forme-study svg { display: block; width: 100%; height: 17em; }
              .forme-study .chase { fill: color-mix(in srgb, var(--palette-2) 48%, var(--card-color)); stroke: var(--body-color); stroke-width: 3; }
              .forme-study .unit { fill: var(--card-color); stroke: var(--body-color); stroke-width: 1.5; }
              .forme-study .active { fill: var(--accent-color); stroke: var(--accent-color); }
              .forme-study .rule { stroke: var(--body-color); stroke-width: 2; fill: none; }
              .forme-study .accent-rule { stroke: var(--accent-color); stroke-width: 3; fill: none; }
              .forme-study text { font-family: var(--body-font); fill: var(--body-color); font-size: 0.72em; }
              .forme-study .small { font-size: 0.6em; letter-spacing: 0.05em; }
              .forme-study .mirror { font-family: var(--heading-font); font-size: 1.2em; font-weight: 700; }
            </style>
            <div class="forme-study">
              <svg viewBox="0 0 560 270" width="560" height="270" role="img" aria-label="Schematic movable-type forme showing separate mirrored units locked into a frame before inking">
                <text x="42" y="20" class="small">SEPARATE, MIRRORED UNITS</text>
                <rect x="40" y="35" width="350" height="190" rx="2" class="chase"/>
                <rect x="62" y="58" width="44" height="42" class="unit"/>
                <rect x="112" y="58" width="44" height="42" class="unit"/>
                <rect x="162" y="58" width="44" height="42" class="active"/>
                <rect x="212" y="58" width="44" height="42" class="unit"/>
                <rect x="262" y="58" width="44" height="42" class="unit"/>
                <rect x="312" y="58" width="44" height="42" class="unit"/>
                <rect x="62" y="107" width="44" height="42" class="unit"/>
                <rect x="112" y="107" width="44" height="42" class="unit"/>
                <rect x="162" y="107" width="44" height="42" class="unit"/>
                <rect x="212" y="107" width="44" height="42" class="unit"/>
                <rect x="262" y="107" width="44" height="42" class="active"/>
                <rect x="312" y="107" width="44" height="42" class="unit"/>
                <rect x="62" y="156" width="44" height="42" class="unit"/>
                <rect x="112" y="156" width="44" height="42" class="unit"/>
                <rect x="162" y="156" width="44" height="42" class="unit"/>
                <rect x="212" y="156" width="44" height="42" class="unit"/>
                <rect x="262" y="156" width="44" height="42" class="unit"/>
                <rect x="312" y="156" width="44" height="42" class="unit"/>
                <g transform="translate(95 88) scale(-1 1)"><text class="mirror">A</text></g>
                <g transform="translate(245 88) scale(-1 1)"><text class="mirror">R</text></g>
                <g transform="translate(145 137) scale(-1 1)"><text class="mirror">G</text></g>
                <g transform="translate(345 186) scale(-1 1)"><text class="mirror">D</text></g>
                <path d="M390 130 H470" class="accent-rule"/>
                <path d="M458 120 L475 130 L458 140" class="accent-rule"/>
                <text x="422" y="108" class="small">INK</text>
                <rect x="478" y="72" width="58" height="118" class="unit"/>
                <line x1="490" y1="92" x2="524" y2="92" class="rule"/>
                <line x1="490" y1="110" x2="524" y2="110" class="rule"/>
                <line x1="490" y1="128" x2="516" y2="128" class="rule"/>
                <line x1="490" y1="154" x2="524" y2="154" class="rule"/>
                <text x="477" y="215" class="small">REPEATABLE COPY</text>
                <text x="42" y="250" class="small">THE CHASE LOCKS SPATIAL DECISIONS BEFORE DISTRIBUTION</text>
              </svg>
            </div>
          </custom-code>
          <p role="caption">Schematic reading of a movable-type forme · not an archival reproduction</p>
        </grid-item>
        <grid-item colspan="25" vertical-align="center">
          <labels><label variant="solid">Material logic</label></labels>
          <h3>Composition becomes repeatable</h3>
          <p>Type, margins, sequence, and edition stabilize hierarchy across copies. Revision occurs before distribution; readers mainly encounter a finished arrangement.</p>
          <p>The forme makes this logic visible: letters remain separate, mirrored units until they are locked into a physical grid before ink reaches paper.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>