        {
          "id": "editorial-media-study",
          "name": "Editorial media study",
          "promptGuidance": "Large-format editorial studio photograph of one media mechanism—modular paper frames, neutral type blocks, screen windows or plotter paths—arranged as a precise material study under cool raking daylight, carbon #171A1C, archive buff #D6C5A9, screen grey #7B929A and vermilion #B5412C on warm paper #F7F3EA, no text or lettering.",
          "subjects": "Conceptual studies of fixed pages, modular interfaces, linked structures, variable systems, and hands arranging neutral components; never reconstructed historical documents, brands, or legible interface text.",
          "whenToUse": "Cover and conceptual transitions where a generated material metaphor adds meaning; use credited archival evidence or native diagrams for historical claims."
        }
      ]
    },
