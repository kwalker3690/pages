<section background-color="heading">
  <grid spacing="none">
    <grid-item colspan="38" vertical-align="center">
      <p role="eyebrow">The Restorative Hour</p>
      <h1 font-size="44pt">A better stay can begin in one hour</h1>
      <p font-size="lg"><b>A guided in-property ritual helps guests shift from travel mode into the character and pace of the hotel.</b></p>
      <p>Designed to feel personal to the guest, repeatable for the team, and commercially testable for the property.</p>
      <spacer mode="fixed" size="16pt"/>
      <grid spacing="small" vertical-sizing="hug">
        <grid-item colspan="30" background-color="surface" padding="14pt 16pt">
          <h4>Guest promise</h4>
          <p font-size="sm">One calm, considered moment built into the stay.</p>
        </grid-item>
        <grid-item colspan="30" background-color="surface" padding="14pt 16pt">
          <h4>Manager proposition</h4>
          <p font-size="sm">A distinctive experience with a defined format, operating model, and pilot decision.</p>
        </grid-item>
      </grid>
    </grid-item>
    <grid-item colspan="22" padding="0">
      <ai-image prompt="Quiet editorial hospitality photograph in a real boutique guest room, a staff member's hands placing a room key beside a clear glass of water and folded white linen on a pale wood table, soft natural window light, crisp white and sea-glass details, deep teal shadows, generous calm space, no text or logos" image-style="restorative-hospitality-editorial" aspect-ratio="portrait" background="true"/>
    </grid-item>
  </grid>
</section>