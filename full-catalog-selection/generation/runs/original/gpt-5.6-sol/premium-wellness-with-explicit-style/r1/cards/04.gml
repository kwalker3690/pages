<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <h2>One hour creates three kinds of value</h2>
      <grid padding-top="36pt" spacing="medium" marker-straddle="true" marker-align="center" marker-position="above" marker-shape="circle" marker-style="solid" marker-size="large" marker="icon" vertical-sizing="hug">
        <grid-item colspan="20" cell-style="subtle">
          <grid-item-label><ai-icon query="hotel guest pausing with tea"></ai-icon></grid-item-label>
          <h3>For guests</h3>
          <p>A low-friction way to pause without planning an off-property appointment or committing to a clinical treatment.</p>
        </grid-item>
        <grid-item colspan="20" cell-style="subtle">
          <grid-item-label><ai-icon query="hotel staff booking handoff"></ai-icon></grid-item-label>
          <h3>For staff</h3>
          <p>A defined offer, booking script, capacity limit, and practitioner handoff clarify what is sold and who delivers it.</p>
        </grid-item>
        <grid-item colspan="20" cell-style="subtle">
          <grid-item-label><ai-icon query="boutique hotel distinctive guest experience"></ai-icon></grid-item-label>
          <h3>For the property</h3>
          <p>A testable route to differentiation, an ancillary charge or package allocation, and a story that expresses the hotel’s character.</p>
        </grid-item>
      </grid>
      <spacer mode="fixed" size="14pt"/>
      <p role="eyebrow">The relationship to test</p>
      <grid recipe="arrows" vertical-sizing="hug">
        <grid-item colspan="15">
          <h4>Guest interest</h4>
        </grid-item>
        <grid-item colspan="15">
          <h4>Bookings</h4>
        </grid-item>
        <grid-item colspan="15">
          <h4>Manageable operation</h4>
        </grid-item>
        <grid-item colspan="15">
          <h4>Positive contribution</h4>
        </grid-item>
      </grid>
      <p role="caption">The pilot measures every link rather than assuming the outcome.</p>
    </grid-item>
  </grid>
</section>