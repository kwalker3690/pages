<section>
  <grid spacing="none">
    <grid-item>
      <h2>Prove the experience before scaling it</h2>
      <labels><label variant="outline">Six-week pilot structure</label></labels>
      <grid spacing="medium" vertical-sizing="fill">
        <grid-item colspan="25" vertical-align="center">
          <smart-layout orientation="vertical" variant="minimalTimelineWithBoxes">
            <smart-layout-item>
              <h4>Weeks 1–2 · Prepare</h4>
              <p font-size="sm">Select the ritual, assess the room, confirm practitioner credentials and local requirements, train the guest-facing script, and test the booking handoff.</p>
            </smart-layout-item>
            <smart-layout-item>
              <h4>Weeks 3–6 · Operate</h4>
              <p font-size="sm">Run the agreed calendar, review attendance and issues weekly, and collect one short guest rating plus optional comments.</p>
            </smart-layout-item>
            <smart-layout-item>
              <h4>End of week 6 · Decide</h4>
              <p font-size="sm">Continue, adapt, or stop according to evidence from guests, staff, and the commercial model.</p>
            </smart-layout-item>
          </smart-layout>
        </grid-item>
        <grid-item colspan="35" vertical-align="center">
          <h3>Illustrative decision gates</h3>
          <table borders="rows" striped="false" col-widths="[62,38]">
            <tr><th>Measure</th><th>Gate to agree</th></tr>
            <tr><td><p font-size="sm">Seat fill</p></td><td><p font-size="sm"><b>At least 40%</b></p></td></tr>
            <tr><td><p font-size="sm">No-show rate</p></td><td><p font-size="sm"><b>15% or below</b></p></td></tr>
            <tr><td><p font-size="sm">Average guest rating</p></td><td><p font-size="sm"><b>At least 4.5/5</b></p></td></tr>
            <tr><td><p font-size="sm">Safety and service issues</p></td><td><p font-size="sm"><b>None unresolved</b></p></td></tr>
            <tr><td><p font-size="sm">Incremental administration</p></td><td><p font-size="sm"><b>Within agreed limit</b></p></td></tr>
            <tr><td><p font-size="sm">Contribution after direct costs</p></td><td><p font-size="sm"><b>Positive</b></p></td></tr>
          </table>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>