<section>
  <grid spacing="none">
    <grid-item>
      <h2>Reveal: what the shield changes</h2>
      <freeform-block w="840" h="286">
        <box type="content" x="0" y="0" w="405" h="278" sizing="fixed" background-color="heading" style="border-radius: 18pt;"></box>
        <box type="content" x="435" y="0" w="405" h="278" sizing="fixed" background-color="heading" style="border-radius: 18pt;"></box>

        <box type="content" x="24" y="14" w="230" sizing="auto"><h3><span text-color="#F8FCFF">More ozone</span></h3></box>
        <box type="content" x="459" y="14" w="230" sizing="auto"><h3><span text-color="#F8FCFF">Less ozone</span></h3></box>

        <shape preset="ellipse" x="35" y="58" w="50" h="50" fill="palette-2" stroke-width="0"></shape>
        <shape preset="ellipse" x="470" y="58" w="50" h="50" fill="palette-2" stroke-width="0"></shape>

        <shape preset="line" x="132" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="184" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="236" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="567" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="619" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="671" y="68" w="2" h="104" stroke="palette-2" stroke-width="4"></shape>

        <box type="content" x="38" y="166" w="329" h="28" sizing="fixed" background-color="accent" style="border-radius: 999pt;"></box>
        <box type="content" x="473" y="166" w="329" h="28" sizing="fixed" background-color="accent" style="border-radius: 999pt;"></box>

        <shape preset="ellipse" x="126" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="178" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="230" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="561" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="613" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="665" y="172" w="16" h="16" fill="surface" stroke-width="0"></shape>

        <shape preset="line" x="236" y="194" w="2" h="45" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="619" y="194" w="2" h="45" stroke="palette-2" stroke-width="4"></shape>
        <shape preset="line" x="671" y="194" w="2" h="45" stroke="palette-2" stroke-width="4"></shape>

        <shape preset="ellipse" x="82" y="214" w="240" h="92" fill="surface" stroke-width="0"></shape>
        <shape preset="ellipse" x="517" y="214" w="240" h="92" fill="surface" stroke-width="0"></shape>

        <box type="content" x="102" y="226" w="200" sizing="auto"><h4 align="center">More is absorbed</h4><p align="center" font-size="13pt">Less harmful UV reaches the ground.</p></box>
        <box type="content" x="537" y="226" w="200" sizing="auto"><h4 align="center">Less is absorbed</h4><p align="center" font-size="13pt">More harmful UV can pass through.</p></box>
      </freeform-block>
      <p font-size="lg"><b>The shield changes the amount. It does not block every ray.</b></p>
    </grid-item>
  </grid>
</section>