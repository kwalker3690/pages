<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <h2>Meet ozone: three oxygen atoms</h2>
      <grid spacing="medium">
        <grid-item colspan="23" vertical-align="center">
          <p>Ozone is <b>O₃</b>: three oxygen atoms joined together. Most protective ozone floats in the <b>stratosphere</b>, the calm layer above our weather.</p>
          <p>It is a region of gas, not a solid shell. Ozone near the ground is a separate pollution problem.</p>
        </grid-item>
        <grid-item colspan="37" vertical-align="center">
          <freeform-block w="560" h="300">
            <shape preset="line" x="78" y="108" w="70" h="2" stroke="palette-4" stroke-width="5"></shape>
            <shape preset="line" x="158" y="108" w="70" h="2" stroke="palette-4" stroke-width="5"></shape>
            <shape preset="ellipse" x="28" y="68" w="82" h="82" fill="accent" stroke-width="0"></shape>
            <shape preset="ellipse" x="113" y="68" w="82" h="82" fill="accent" stroke-width="0"></shape>
            <shape preset="ellipse" x="198" y="68" w="82" h="82" fill="accent" stroke-width="0"></shape>
            <box type="content" x="34" y="92" w="70" sizing="auto"><h3 align="center"><span text-color="#F8FCFF">O</span></h3></box>
            <box type="content" x="119" y="92" w="70" sizing="auto"><h3 align="center"><span text-color="#F8FCFF">O</span></h3></box>
            <box type="content" x="204" y="92" w="70" sizing="auto"><h3 align="center"><span text-color="#F8FCFF">O</span></h3></box>
            <box type="content" x="65" y="166" w="180" sizing="auto"><h3 align="center">O₃</h3><p align="center">one ozone molecule</p></box>
            <box type="content" x="310" y="18" w="230" h="264" sizing="fixed" background-color="heading" style="border-radius: 18pt;"></box>
            <box type="content" x="325" y="78" w="200" h="58" sizing="fixed" background-color="accent" vertical-align="center" style="padding: 8pt 12pt; border-radius: 12pt;">
              <p align="center"><b>Protective ozone region</b></p>
            </box>
            <shape preset="ellipse" x="334" y="207" w="182" h="62" fill="surface" stroke-width="0"></shape>
            <box type="content" x="332" y="39" w="186" sizing="auto"><p align="center"><span text-color="#F8FCFF"><b>Stratosphere</b></span></p></box>
            <box type="content" x="347" y="181" w="156" sizing="auto"><p align="center"><span text-color="#F8FCFF">weather below</span></p></box>
            <box type="content" x="354" y="225" w="142" sizing="auto"><p align="center" font-size="13pt"><b>Earth’s surface</b></p></box>
          </freeform-block>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>