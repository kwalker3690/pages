<section card-margin-hidden="true" background-overlay="tint" background-overlay-intensity="0.38" vertical-align="end">
  <ai-image background="true" aspect-ratio="landscape" image-style="practical-light-afterimage" prompt="High-contrast editorial studio photograph of anonymous hands holding a sheet of black paper at the far right while a narrow bone-white beam enters through a cut aperture and leaves a controlled coral and amber afterimage across the frame, left third kept as deep near-black negative space, practical hard light, restrained film grain, no faces, logos, text, or lettering"></ai-image>
  <grid spacing="none">
    <grid-item vertical-align="end">
      <p role="eyebrow">Provisional conference topic</p>
      <display size="lg">Make room<br/>for the unexpected</display>
      <hr horizontalAlign="left" width="xs" thickness="md" color="accent"/>
      <p font-size="lg" style="padding-right: 42%">Creative experimentation is not waiting for lightning. It is building conditions where surprise can appear, be recognized, and become useful.</p>
    </grid-item>
  </grid>
</section>