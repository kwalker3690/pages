<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <display font-size="50pt">A perfect plan can only deliver<br/><span text-color="accent">what it already knows</span></display>
      <spacer mode="fixed" size="20pt"/>
      <grid divider="sm neutral-border">
        <grid-item colspan="30">
          <p role="eyebrow">Efficiency</p>
          <p font-size="lg">Removing variation is valuable when the destination is known—and dangerous when the destination is the question.</p>
        </grid-item>
        <grid-item colspan="30">
          <p role="eyebrow">The creative paradox</p>
          <p font-size="lg">We need enough structure to act, with enough openness to encounter something we did not prescribe.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>