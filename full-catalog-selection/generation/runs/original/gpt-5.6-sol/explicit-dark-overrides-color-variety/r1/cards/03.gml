<section>
  <grid spacing="none">
    <grid-item>
      <h2>Two loops. Two outcomes.</h2>
      <p>Complementary modes: choose the loop that matches what is known.</p>
      <grid spacing="medium">
        <grid-item colspan="30" cell-style="subtle">
          <p role="eyebrow">Production loop</p>
          <smart-layout variant="cycle" cell-size="10">
            <smart-layout-item><h4>Define</h4></smart-layout-item>
            <smart-layout-item><h4>Execute</h4></smart-layout-item>
            <smart-layout-item><h4>Verify</h4></smart-layout-item>
            <smart-layout-item><h4>Repeat</h4></smart-layout-item>
          </smart-layout>
          <p font-size="sm">Protects quality when the destination is known.</p>
        </grid-item>
        <grid-item colspan="30" cell-style="subtle">
          <p role="eyebrow">Discovery loop</p>
          <smart-layout variant="cycle" cell-size="10">
            <smart-layout-item><h4>Frame</h4></smart-layout-item>
            <smart-layout-item><h4>Vary</h4></smart-layout-item>
            <smart-layout-item><h4>Notice</h4></smart-layout-item>
            <smart-layout-item><h4>Select</h4></smart-layout-item>
            <smart-layout-item><h4>Learn</h4></smart-layout-item>
          </smart-layout>
          <p font-size="sm">Creates evidence when the destination is not known.</p>
        </grid-item>
      </grid>
      <p role="caption">Confuse the modes and we get polished sameness—or exploration without consequence.</p>
    </grid-item>
  </grid>
</section>