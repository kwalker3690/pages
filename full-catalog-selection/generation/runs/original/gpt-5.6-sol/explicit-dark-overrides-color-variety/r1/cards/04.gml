<section>
  <grid spacing="none">
    <grid-item>
      <h2>Not a brainstorm. A bounded bet.</h2>
      <p font-size="lg">A useful experiment has edges.</p>
      <grid spacing="small" vertical-sizing="fill">
        <grid-item colspan="20" cell-style="subtle" cell-decor="side-line">
          <labels><label variant="solid">Question</label></labels>
          <h4>What are we trying to learn?</h4>
        </grid-item>
        <grid-item colspan="20" cell-style="subtle" cell-decor="side-line">
          <labels><label variant="solid">Constants</label></labels>
          <h4>What must remain stable?</h4>
        </grid-item>
        <grid-item colspan="20" cell-style="subtle" cell-decor="side-line">
          <labels><label variant="solid">Variable</label></labels>
          <h4>What changes this time?</h4>
        </grid-item>
        <grid-item colspan="30" cell-style="subtle" cell-decor="side-line">
          <labels><label variant="solid">Signal</label></labels>
          <h4>What would make the result worth pursuing?</h4>
        </grid-item>
        <grid-item colspan="30" cell-style="subtle" cell-decor="side-line">
          <labels><label variant="solid">Stop</label></labels>
          <h4>When will we decide?</h4>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>