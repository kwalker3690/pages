<section card-margin-hidden="true" background-overlay="tint" background-overlay-intensity="0.52" vertical-align="end">
  <ai-image background="true" aspect-ratio="landscape" image-style="practical-light-afterimage" prompt="High-contrast editorial studio photograph of a near-black doorway standing slightly open on the right, a narrow bone-white rectangle of practical hard light crossing the floor, one amber long-exposure line passing through the opening and leaving a faint ultraviolet residual trace, deep uncluttered negative space on the left, restrained film grain, no people, logos, text, or lettering"></ai-image>
  <grid spacing="none">
    <grid-item vertical-align="end">
      <p role="eyebrow">Protect the promise. Loosen the route.</p>
      <display size="lg">Leave a door open</display>
      <p font-size="lg" style="padding-right: 38%">Make one constraint explicit. Change one variable. Notice what surprises you. Keep what earns its place.</p>
      <hr horizontalAlign="left" width="xs" thickness="md" color="accent"/>
      <h3 role="subheading" style="padding-right: 34%">The unexpected is not the opposite of rigor. It is what rigor can be designed to discover.</h3>
    </grid-item>
  </grid>
</section>