<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Illustrative example—not measured conference data</p>
      <h2>One brief, 24 departures</h2>
      <grid recipe="process-steps" spacing="medium">
        <grid-item colspan="15">
          <h4>Frame</h4>
          <p>Fix one six-word brief, monochrome, and 30 minutes. Change one rule per round.</p>
        </grid-item>
        <grid-item colspan="15">
          <h4>Generate</h4>
          <formula>4 \times 6 = 24</formula>
          <p>Four rounds create 24 departures.</p>
        </grid-item>
        <grid-item colspan="15">
          <h4>Mark</h4>
          <p>Three reviewers independently mark “surprising” and “usable.”</p>
        </grid-item>
        <grid-item colspan="15">
          <h4>Advance</h4>
          <p>Continue ideas earning both marks from at least two reviewers.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>