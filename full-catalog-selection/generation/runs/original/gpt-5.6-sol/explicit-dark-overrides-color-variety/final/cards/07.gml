<section>
  <grid spacing="none">
    <grid-item>
      <h2>Open a 72-hour aperture</h2>
      <p font-size="lg">Act before the idea becomes precious.</p>
      <smart-layout orientation="horizontal" variant="minimalTimeline">
        <smart-layout-item>
          <h4>Today</h4>
          <p>Write one question and name the constants.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>Tomorrow</h4>
          <p>Run three variations with one changed rule.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>Within 72 hours</h4>
          <p>Show two people, record their signals, and choose what continues.</p>
        </smart-layout-item>
      </smart-layout>
      <spacer mode="fixed" size="16pt"/>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="accent" padding="14pt 18pt">
          <h4>What did the interruption reveal that the plan concealed?</h4>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>