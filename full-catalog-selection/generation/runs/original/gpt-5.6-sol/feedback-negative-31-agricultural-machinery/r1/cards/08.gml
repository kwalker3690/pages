<section vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Operating standard</p>
      <h2>The field rule: measure, improve, remeasure</h2>
      <smart-layout variant="cycle">
        <smart-layout-item>
          <ai-icon query="field capacity measurement"></ai-icon>
          <h4>Measure</h4>
          <p>Record effective capacity under real field conditions.</p>
        </smart-layout-item>
        <smart-layout-item>
          <ai-icon query="stopwatch loss analysis"></ai-icon>
          <h4>Separate</h4>
          <p>Isolate turning, waiting, adjustment and stoppage losses.</p>
        </smart-layout-item>
        <smart-layout-item>
          <ai-icon query="agricultural machine comparison"></ai-icon>
          <h4>Compare</h4>
          <p>Test viable machines in work-window hours and cost per hectare.</p>
        </smart-layout-item>
        <smart-layout-item>
          <ai-icon query="route calibration maintenance"></ai-icon>
          <h4>Improve first</h4>
          <p>Fix routing, logistics, calibration and maintenance before adding capacity.</p>
        </smart-layout-item>
        <smart-layout-item>
          <ai-icon query="quality inspection repeat measurement"></ai-icon>
          <h4>Remeasure</h4>
          <p>Check cost and work quality after every change.</p>
        </smart-layout-item>
      </smart-layout>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="accent" padding="14pt 18pt">
          <h3>Which lost minute is cheapest to eliminate before buying more machine?</h3>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>