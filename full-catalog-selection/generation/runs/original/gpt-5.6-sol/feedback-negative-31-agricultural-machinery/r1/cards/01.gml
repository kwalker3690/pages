<section>
  <grid spacing="none">
    <grid-item colspan="36" vertical-align="center">
      <p role="eyebrow">Illustrative replacement · 12 ha field</p>
      <h1 font-size="48pt">The gap is five hours</h1>
      <p font-size="lg">At 2.0 m and 5.0 km/h, field losses turn a theoretical 12.00-hour job into 17.14 hours of work.</p>
      <spacer mode="fixed" size="16pt"></spacer>
      <grid divider="sm neutral-border" vertical-sizing="hug">
        <grid-item colspan="20">
          <display size="md">1.00</display>
          <h4>ha/hour theoretical</h4>
          <p font-size="sm">Width and speed, before losses.</p>
        </grid-item>
        <grid-item colspan="20">
          <display size="md">0.70</display>
          <h4>ha/hour effective</h4>
          <p font-size="sm">At 70% field efficiency.</p>
        </grid-item>
        <grid-item colspan="20">
          <display size="md"><span text-color="accent">5.14</span></display>
          <h4>hours added</h4>
          <p font-size="sm">The gap to explain and reduce.</p>
        </grid-item>
      </grid>
      <spacer mode="fixed" size="14pt"></spacer>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="accent" padding="12pt 16pt">
          <h4>Efficiency begins by explaining that 5.14-hour gap.</h4>
        </grid-item>
      </grid>
      <p role="caption">The source document was not supplied; all examples in this deck are created and illustrative.</p>
    </grid-item>
    <grid-item colspan="24" padding="0">
      <ai-image prompt="Elevated documentary photograph of an unbranded compact tractor working a rectangular cultivated field, parallel passes and a broad headland clearly visible, neutral overcast daylight, realistic soil texture, carbon-black and machine-gray equipment with one restrained signal-red marker, no text, no logos, no identifiable people" image-style="technical-field-documentary" aspect-ratio="portrait" fill="true"></ai-image>
    </grid-item>
  </grid>
</section>