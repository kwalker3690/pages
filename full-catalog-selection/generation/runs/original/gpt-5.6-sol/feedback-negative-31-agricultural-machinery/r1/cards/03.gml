<section>
  <grid spacing="none">
    <grid-item colspan="37">
      <h2>Efficiency is won across five stages</h2>
      <grid direction="vertical" vertical-sizing="fill" divider="sm neutral-border" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" marker-style="subtle" marker-shape="rounded" style="--marker-inline-size:30pt; --marker-gap:12pt">
        <grid-item padding="8pt 0">
          <h4>Plan</h4>
          <p>Map field shape, access and the available work window.</p>
        </grid-item>
        <grid-item padding="8pt 0">
          <h4>Select</h4>
          <p>Match implement, tractor power and expected utilization.</p>
        </grid-item>
        <grid-item padding="8pt 0">
          <h4>Set up</h4>
          <p>Calibrate width, depth, pressure and inputs.</p>
        </grid-item>
        <grid-item padding="8pt 0">
          <h4>Operate</h4>
          <p>Control speed, overlap, turns and refill waiting.</p>
        </grid-item>
        <grid-item padding="8pt 0">
          <h4>Verify</h4>
          <p>Inspect quality, record losses and correct the next run.</p>
        </grid-item>
      </grid>
    </grid-item>
    <grid-item colspan="23" padding="0">
      <ai-image prompt="Elevated documentary photograph of an unbranded tractor turning precisely at a field headland while input containers are staged beside the access lane, route geometry and waiting points visible, neutral overcast daylight, realistic soil and crop texture, white, carbon-black and machine-gray palette with restrained signal-red cones, no text, no logos, no identifiable people" image-style="technical-field-documentary" aspect-ratio="portrait" fill="true"></ai-image>
    </grid-item>
  </grid>
</section>