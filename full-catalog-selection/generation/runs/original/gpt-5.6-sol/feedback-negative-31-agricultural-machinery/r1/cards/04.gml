<section>
  <grid spacing="none">
    <grid-item colspan="17" padding="0">
      <ai-image prompt="Close technical documentary photograph of gloved operator hands aligning an unbranded tractor hitch with a field implement, coupling points, hydraulic lines and working-width hardware clearly visible, neutral overcast daylight, machine-gray metal with one restrained signal-red safety detail, no text, no logos, no identifiable face" image-style="technical-field-documentary" aspect-ratio="portrait" fill="true"></ai-image>
    </grid-item>
    <grid-item colspan="43" vertical-align="center">
      <p role="eyebrow">Illustrative options · same field task</p>
      <h2>Select the system, not the biggest machine</h2>
      <grid spacing="medium" vertical-sizing="hug">
        <grid-item colspan="30" cell-style="subtle">
          <labels><label variant="outline">Option A</label></labels>
          <h3>2.0 m system</h3>
          <formula>2.0\times5.0\times0.70\div10=0.70</formula>
          <p>Effective capacity, ha/hour</p>
          <display size="md">$77.14<span font-size="18pt">/ha</span></display>
          <formula>\$54/\text{hour}\div0.70=\$77.14/\text{ha}</formula>
        </grid-item>
        <grid-item colspan="30" cell-style="subtle">
          <labels><label variant="solid">Option B · Conditional advantage</label></labels>
          <h3>3.0 m system</h3>
          <formula>3.0\times6.0\times0.75\div10=1.35</formula>
          <p>Effective capacity, ha/hour</p>
          <display size="md">$57.78<span font-size="18pt">/ha</span></display>
          <formula>\$78/\text{hour}\div1.35=\$57.78/\text{ha}</formula>
        </grid-item>
      </grid>
      <p><b>Select B only if power, hitch, soil load, transport width, access and annual use are acceptable.</b></p>
    </grid-item>
  </grid>
</section>