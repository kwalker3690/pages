<section>
  <grid spacing="none">
    <grid-item>
      <h2>Stretch the chart, not the ships</h2>
      <p><b>Chart test:</b> mark three galaxies on a flexible grid, then enlarge the grid. Every pair separates; from any marker, the other two recede. No marker becomes the privileged center.</p>
      <freeform-block w="840" h="230">
        <shape preset="roundRect" x="0" y="8" w="360" h="206" fill="surface" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="roundRect" x="480" y="8" w="360" h="206" fill="surface" stroke="palette-5" stroke-width="1"></shape>

        <shape preset="line" x="70" y="38" w="0" h="150" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="145" y="38" w="0" h="150" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="220" y="38" w="0" h="150" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="295" y="38" w="0" h="150" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="38" y="65" w="284" h="0" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="38" y="112" w="284" h="0" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="38" y="159" w="284" h="0" stroke="palette-5" stroke-width="1"></shape>

        <shape preset="line" x="100" y="76" w="150" h="10" stroke="accent" stroke-width="2"></shape>
        <shape preset="line" x="175" y="86" w="75" h="84" stroke="accent" stroke-width="2" flip-h="true"></shape>
        <shape preset="line" x="100" y="76" w="75" h="94" stroke="accent" stroke-width="2"></shape>
        <shape preset="ellipse" x="92" y="68" w="16" h="16" fill="palette-2" stroke-width="0"></shape>
        <shape preset="ellipse" x="242" y="78" w="16" h="16" fill="palette-3" stroke-width="0"></shape>
        <shape preset="ellipse" x="167" y="162" w="16" h="16" fill="accent" stroke-width="0"></shape>

        <shape preset="rightArrow" x="397" y="96" w="46" h="28" fill="palette-2" stroke-width="0"></shape>

        <shape preset="line" x="540" y="28" w="0" h="174" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="620" y="28" w="0" h="174" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="700" y="28" w="0" h="174" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="780" y="28" w="0" h="174" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="500" y="52" w="320" h="0" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="500" y="112" w="320" h="0" stroke="palette-5" stroke-width="1"></shape>
        <shape preset="line" x="500" y="172" w="320" h="0" stroke="palette-5" stroke-width="1"></shape>

        <shape preset="line" x="520" y="48" w="270" h="10" stroke="accent" stroke-width="2"></shape>
        <shape preset="line" x="650" y="58" w="140" h="130" stroke="accent" stroke-width="2" flip-h="true"></shape>
        <shape preset="line" x="520" y="48" w="130" h="140" stroke="accent" stroke-width="2"></shape>
        <shape preset="ellipse" x="512" y="40" w="16" h="16" fill="palette-2" stroke-width="0"></shape>
        <shape preset="ellipse" x="782" y="50" w="16" h="16" fill="palette-3" stroke-width="0"></shape>
        <shape preset="ellipse" x="642" y="180" w="16" h="16" fill="accent" stroke-width="0"></shape>

        <box type="content" x="18" y="16" w="145" sizing="auto"><p font-size="sm"><b>Same grid markers</b></p></box>
        <box type="content" x="498" y="16" w="190" sizing="auto"><p font-size="sm"><b>Grid enlarged</b></p></box>
        <box type="content" x="80" y="82" w="24" sizing="auto"><p font-size="sm">A</p></box>
        <box type="content" x="260" y="80" w="24" sizing="auto"><p font-size="sm">B</p></box>
        <box type="content" x="184" y="170" w="24" sizing="auto"><p font-size="sm">C</p></box>
        <box type="content" x="500" y="58" w="24" sizing="auto"><p font-size="sm">A</p></box>
        <box type="content" x="802" y="50" w="24" sizing="auto"><p font-size="sm">B</p></box>
        <box type="content" x="660" y="181" w="24" sizing="auto"><p font-size="sm">C</p></box>
      </freeform-block>
      <grid spacing="medium" vertical-sizing="hug">
        <grid-item colspan="30">
          <p font-size="sm"><b>The grid</b> represents changing distances in space.</p>
        </grid-item>
        <grid-item colspan="30">
          <p font-size="sm"><b>The markers</b> are not ships crossing a surrounding cosmic ocean.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>