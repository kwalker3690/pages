<section>
  <grid spacing="none">
    <grid-item>
      <h2>Minimum evidence for an investable transition plan</h2>
      <p>The plan becomes investable when the exposure map, operating records and funded response reconcile.</p>
      <grid spacing="large" vertical-sizing="fill">
        <grid-item colspan="37">
          <h3>Minimum evidence pack</h3>
          <grid style="--marker-inline-size: 30pt; --marker-gap: 12pt" direction="vertical" vertical-sizing="fill" marker="number" marker-position="inline" marker-numbering-format="decimal-leading-zero" marker-style="subtle" marker-shape="rounded" divider="sm neutral-border">
            <grid-item padding="10pt 0">
              <p>Inventory by substance, equipment, location, age and ownership.</p>
            </grid-item>
            <grid-item padding="10pt 0">
              <p>Leak, maintenance, servicing, recovery and disposal records.</p>
            </grid-item>
            <grid-item padding="10pt 0">
              <p>Replacement schedule, approved capex, suppliers and technician capacity.</p>
            </grid-item>
            <grid-item padding="10pt 0">
              <p>Scenario ownership and board-level accountability.</p>
            </grid-item>
          </grid>
        </grid-item>
        <grid-item colspan="23">
          <h3>Decision gates</h3>
          <grid direction="vertical" spacing="small" vertical-sizing="fill">
            <grid-item background-color="palette-3">
              <h4>Underwrite</h4>
              <p>Inventory and funded plan are credible.</p>
            </grid-item>
            <grid-item background-color="palette-1">
              <h4>Reserve + engage</h4>
              <p>Evidence gaps are bounded and management has an owner.</p>
            </grid-item>
            <grid-item background-color="palette-2">
              <h4>Defer</h4>
              <p>Unknown exposure could be material.</p>
            </grid-item>
          </grid>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>