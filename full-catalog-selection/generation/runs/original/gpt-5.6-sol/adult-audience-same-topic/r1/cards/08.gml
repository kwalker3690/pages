<section background-color="heading" vertical-align="center">
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Committee decision</p>
      <h1 font-size="38pt">Committee decision: turn unknowns into priced evidence</h1>
      <h3 role="subheading">Approve a 90-day portfolio screen.</h3>
      <grid padding-top="28pt" spacing="medium" marker="number" marker-position="above" marker-align="center" marker-style="solid" marker-shape="circle" marker-size="large" marker-straddle="true">
        <grid-item colspan="15" background-color="surface">
          <h4>Prioritize assets</h4>
          <p>Screen refrigeration, cooling, foam, fire-suppression and process dependence.</p>
        </grid-item>
        <grid-item colspan="15" background-color="surface">
          <h4>Classify substance</h4>
          <p>Assign ODS, HFC, lower-impact substitute, or unknown.</p>
        </grid-item>
        <grid-item colspan="15" background-color="surface">
          <h4>Price the evidence</h4>
          <p>Request the minimum pack and rerun the illustrative stresses.</p>
        </grid-item>
        <grid-item colspan="15" background-color="surface">
          <h4>Govern escalation</h4>
          <p>Set thresholds, engagement owners and reporting cadence.</p>
        </grid-item>
      </grid>
      <spacer mode="fixed" size="14pt"/>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="palette-2" padding="12pt 16pt">
          <h3>No substance map, no confident transition valuation.</h3>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>