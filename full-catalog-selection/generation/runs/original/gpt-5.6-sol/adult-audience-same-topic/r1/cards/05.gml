<section>
  <grid spacing="none">
    <grid-item>
      <p role="eyebrow">Illustrative example · Not portfolio data</p>
      <h2>Illustrative portfolio matrix: urgency × materiality</h2>
      <freeform-block w="840" h="290">
        <box type="content" x="90" y="15" w="355" h="118" sizing="fixed" background-color="rgba(45,111,142,0.06)" locked="true"></box>
        <box type="content" x="445" y="15" w="355" h="118" sizing="fixed" background-color="rgba(182,78,60,0.10)" locked="true"></box>
        <box type="content" x="90" y="133" w="355" h="117" sizing="fixed" background-color="rgba(93,102,107,0.04)" locked="true"></box>
        <box type="content" x="445" y="133" w="355" h="117" sizing="fixed" background-color="rgba(40,122,114,0.06)" locked="true"></box>
        <shape preset="line" x="90" y="250" w="710" h="2" stroke="neutral-border" stroke-width="2" locked="true"></shape>
        <shape preset="line" x="90" y="15" w="2" h="235" stroke="neutral-border" stroke-width="2" locked="true"></shape>
        <box type="content" x="2" y="18" w="78" sizing="auto">
          <p font-size="11pt" align="right"><b>HIGH</b><br/>financial materiality</p>
        </box>
        <box type="content" x="4" y="215" w="76" sizing="auto">
          <p font-size="11pt" align="right"><b>LOW</b></p>
        </box>
        <box type="content" x="92" y="258" w="170" sizing="auto">
          <p font-size="11pt">LOW transition urgency</p>
        </box>
        <box type="content" x="625" y="258" w="175" sizing="auto">
          <p font-size="11pt" align="right">HIGH transition urgency</p>
        </box>
        <box type="content" x="595" y="34" w="195" h="74" sizing="fixed" background-color="palette-2" style="padding: 8pt 10pt;">
          <h4 font-size="13pt">ACT NOW · ODS</h4>
          <p font-size="11pt">Legacy-ODS cold store · 4/5 urgency · 4/5 impact<br/><b>Reserve + engage</b></p>
        </box>
        <box type="content" x="360" y="57" w="215" h="84" sizing="fixed" background-color="palette-3" style="padding: 8pt 10pt;">
          <h4 font-size="13pt">PLAN · HFC</h4>
          <p font-size="11pt">HFC-heavy supermarket estate · 3/5 urgency · 4/5 impact<br/>Climate exposure; not ozone depletion.</p>
        </box>
        <box type="content" x="360" y="164" w="215" h="74" sizing="fixed" background-color="palette-1" style="padding: 8pt 10pt;">
          <h4 font-size="13pt">VERIFY · UNKNOWN</h4>
          <p font-size="11pt">Older fire suppression · 3/5 urgency · 2/5 impact<br/><b>Defer if material</b></p>
        </box>
        <box type="content" x="105" y="190" w="220" h="58" sizing="fixed" background-color="surface" style="padding: 7pt 10pt;">
          <h4 font-size="13pt">MONITOR · INDIRECT</h4>
          <p font-size="11pt">Landlord-controlled HVAC · 1/5 urgency · 1/5 impact</p>
        </box>
      </freeform-block>
      <p role="caption">Scores and holdings are illustrative replacements—not portfolio data. Confirm all five coordinates before assigning underwrite, reserve, engage, monitor, or defer.</p>
    </grid-item>
  </grid>
</section>