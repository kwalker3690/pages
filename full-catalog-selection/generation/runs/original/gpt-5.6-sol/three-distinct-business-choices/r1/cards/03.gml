<section>
  <grid spacing="none">
    <grid-item>
      <h2>Four quarters reveal a quality trade-off</h2>
      <p font-size="sm"><b>Illustrative example — not company data.</b></p>
      <grid spacing="medium">
        <grid-item colspan="20">
          <h4>Revenue ($M)</h4>
          <graph chart-type="line" width="260pt" height="205pt" text-size="sm" line-weight="md" show-data-labels="true" config='{"legend":{"position":"none"},"appearance":{"customSeriesColors":{"series1":{"color":"#17715B"}}}}'>
            <properties>
              <property key="quarter" label="Quarter" type="label"/>
              <property key="revenue" label="Revenue ($M)" type="data"/>
            </properties>
            <data>
              <row><cell>Q−3</cell><cell>21.2</cell></row>
              <row><cell>Q−2</cell><cell>22.1</cell></row>
              <row><cell>Q−1</cell><cell>23.4</cell></row>
              <row><cell>Current</cell><cell>24.8</cell></row>
            </data>
          </graph>
        </grid-item>
        <grid-item colspan="20">
          <h4>Gross margin (%)</h4>
          <graph chart-type="line" width="260pt" height="205pt" text-size="sm" line-weight="md" show-data-labels="true" config='{"legend":{"position":"none"},"appearance":{"customSeriesColors":{"series1":{"color":"#17715B"}}}}'>
            <properties>
              <property key="quarter" label="Quarter" type="label"/>
              <property key="margin" label="Gross margin (%)" type="data"/>
            </properties>
            <data>
              <row><cell>Q−3</cell><cell>57</cell></row>
              <row><cell>Q−2</cell><cell>58</cell></row>
              <row><cell>Q−1</cell><cell>59</cell></row>
              <row><cell>Current</cell><cell>61</cell></row>
            </data>
          </graph>
        </grid-item>
        <grid-item colspan="20">
          <h4>Net revenue retention (%)</h4>
          <graph chart-type="line" width="260pt" height="205pt" text-size="sm" line-weight="md" show-data-labels="true" config='{"legend":{"position":"none"},"appearance":{"customSeriesColors":{"series1":{"color":"#D63F24"}}}}'>
            <properties>
              <property key="quarter" label="Quarter" type="label"/>
              <property key="nrr" label="Net revenue retention (%)" type="data"/>
            </properties>
            <data>
              <row><cell>Q−3</cell><cell>114</cell></row>
              <row><cell>Q−2</cell><cell>112</cell></row>
              <row><cell>Q−1</cell><cell>110</cell></row>
              <row><cell>Current</cell><cell>108</cell></row>
            </data>
          </graph>
        </grid-item>
      </grid>
      <p><b>Acquisition and efficiency strengthened while customer expansion softened for four consecutive quarters.</b></p>
    </grid-item>
  </grid>
</section>