<section>
  <grid spacing="none">
    <grid-item>
      <h2>The next-quarter plan links actions to outcomes</h2>
      <p font-size="sm"><b>Illustrative example — not company data.</b></p>
      <grid divider="sm neutral-border" vertical-sizing="hug">
        <grid-item colspan="15" vertical-align="center">
          <p font-size="34pt"><b>$26.0M</b></p>
          <h4>Revenue</h4>
          <p font-size="sm">Quarter-end outcome</p>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <p font-size="34pt"><b>62%</b></p>
          <h4>Gross margin</h4>
          <p font-size="sm">Quarter-end outcome</p>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <p font-size="34pt"><b>109%</b></p>
          <h4>Retention</h4>
          <p font-size="sm">Quarter-end outcome</p>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <p font-size="34pt"><b>$0.2M</b></p>
          <h4>Free cash flow</h4>
          <p font-size="sm">Positive at quarter end</p>
        </grid-item>
      </grid>
      <h3>Operating milestones</h3>
      <smart-layout orientation="horizontal" variant="minimalTimeline">
        <smart-layout-item>
          <h4>Days 1–30 · Build the controls</h4>
          <p>Staff the onboarding pod and publish pricing rules.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>Days 31–60 · Move the indicators</h4>
          <p>Reduce the onboarding backlog and activate expansion plays.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>Quarter end · Scale what works</h4>
          <p>Scale only interventions that improve leading indicators.</p>
        </smart-layout-item>
      </smart-layout>
    </grid-item>
  </grid>
</section>