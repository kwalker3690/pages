<section>
  <grid spacing="none">
    <grid-item>
      <h2>The quarter at a glance</h2>
      <p font-size="sm"><b>Illustrative example — not company data.</b></p>
      <grid vertical-sizing="fill" divider="sm neutral-border">
        <grid-item colspan="15" vertical-align="center">
          <display size="md">$24.8M</display>
          <h4>Revenue</h4>
          <p><span text-color="palette-2"><b>6% growth</b></span> quarter over quarter.</p>
          <labels><label variant="outline">96% of plan</label></labels>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <display size="md">61%</display>
          <h4>Gross margin</h4>
          <p><span text-color="palette-2"><b>Up 2 points</b></span> from the prior quarter.</p>
          <labels><label variant="outline">1 point below plan</label></labels>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <display size="md">108%</display>
          <h4>Net revenue retention</h4>
          <p><span text-color="accent"><b>Down 2 points</b></span> quarter over quarter.</p>
          <labels><label variant="solid">2 points below plan</label></labels>
        </grid-item>
        <grid-item colspan="15" vertical-align="center">
          <display size="md">−$0.6M</display>
          <h4>Free cash flow</h4>
          <p><span text-color="palette-2"><b>Improved $1.1M</b></span> in the quarter.</p>
          <labels><label variant="outline">$0.2M below plan</label></labels>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>