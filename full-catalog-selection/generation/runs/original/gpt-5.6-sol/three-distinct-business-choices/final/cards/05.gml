<section>
  <grid spacing="none">
    <grid-item>
      <h2>Three leading risks could break the plan</h2>
      <p font-size="sm"><b>Illustrative example — not company data.</b></p>
      <table borders="rows" striped="false" col-widths="[18,12,14,38,18]">
        <tr>
          <th>Leading risk</th>
          <th>Current</th>
          <th>Guardrail / target</th>
          <th>Required response</th>
          <th>Owner</th>
        </tr>
        <tr>
          <td><b>Demand</b><br/>Pipeline coverage</td>
          <td background-color="palette-3"><b>2.7×</b></td>
          <td>3.0×</td>
          <td>Sales intervenes if mid-quarter coverage remains below 2.8×.</td>
          <td>Sales</td>
        </tr>
        <tr>
          <td><b>Adoption</b><br/>Onboarding time</td>
          <td background-color="palette-3"><b>18 days</b></td>
          <td>14 days</td>
          <td>Recover onboarding performance to the stated target.</td>
          <td>Customer leadership</td>
        </tr>
        <tr>
          <td><b>Concentration</b><br/>Top-ten revenue share</td>
          <td background-color="palette-3"><b>34%</b></td>
          <td>30%</td>
          <td>Monitor exposure while commercial capacity shifts toward expansion.</td>
          <td>Finance</td>
        </tr>
      </table>
      <aside variant="warning"><p>All three signals are outside their guardrail or target before the quarter begins.</p></aside>
    </grid-item>
  </grid>
</section>