<section>
  <grid spacing="none">
    <grid-item>
      <h2>How lục bát moves</h2>
      <freeform-block w="840" h="210">
        <box type="content" x="0" y="20" w="125" sizing="auto">
          <p role="eyebrow">Six syllables</p>
        </box>
        <box type="content" x="0" y="128" w="125" sizing="auto">
          <p role="eyebrow">Eight syllables</p>
        </box>

        <box type="content" x="145" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">1</p><h4>Trăm</h4></box>
        <box type="content" x="245" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">2</p><h4>năm</h4></box>
        <box type="content" x="345" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">3</p><h4>trong</h4></box>
        <box type="content" x="445" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">4</p><h4>cõi</h4></box>
        <box type="content" x="545" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">5</p><h4>người</h4></box>
        <box type="content" x="645" y="8" w="82" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="accent" style="padding: 5pt; border-radius: 3pt;"><p role="caption">6</p><h4>ta</h4></box>

        <box type="content" x="145" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">1</p><h4>Chữ</h4></box>
        <box type="content" x="230" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">2</p><h4>tài</h4></box>
        <box type="content" x="315" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">3</p><h4>chữ</h4></box>
        <box type="content" x="400" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">4</p><h4>mệnh</h4></box>
        <box type="content" x="485" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">5</p><h4>khéo</h4></box>
        <box type="content" x="570" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="accent" style="padding: 5pt; border-radius: 3pt;"><p role="caption">6</p><h4>là</h4></box>
        <box type="content" x="655" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">7</p><h4>ghét</h4></box>
        <box type="content" x="740" y="116" w="78" h="62" sizing="fixed" vertical-align="center" horizontal-align="center" background-color="surface" style="padding: 5pt; border-radius: 3pt;"><p role="caption">8</p><h4>nhau</h4></box>

        <shape preset="line" x="607" y="92" w="87" h="2" rotation="-28" stroke="accent" stroke-width="3"></shape>
        <box type="content" x="695" y="82" w="130" sizing="auto">
          <p role="caption"><b>ta–là rhyme bridge</b></p>
        </box>
      </freeform-block>
      <grid spacing="medium" vertical-sizing="hug">
        <grid-item colspan="20">
          <h4>Bridge</h4>
          <p font-size="sm"><b>ta</b> and <b>là</b> rhyme at position six.</p>
        </grid-item>
        <grid-item colspan="20">
          <h4>Continuation</h4>
          <p font-size="sm">The eight-syllable line’s final rhyme can connect to position six of the next six-syllable line.</p>
        </grid-item>
        <grid-item colspan="20">
          <h4>Method</h4>
          <p font-size="sm">Vietnamese tone and recurring rhyme shape cadence; English paraphrase cannot prove the original meter.</p>
        </grid-item>
      </grid>
      <p font-size="sm">Text source: <a href="https://www.nomfoundation.org/nom-project/Tale-of-Kieu?uiLang=vn">Vietnamese Nôm Preservation Foundation</a>.</p>
    </grid-item>
  </grid>
</section>