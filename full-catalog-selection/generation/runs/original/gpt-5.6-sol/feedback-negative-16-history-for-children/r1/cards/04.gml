<section>
  <grid spacing="none">
    <grid-item>
      <h2>A ten-year timeline</h2>
      <labels><label variant="solid">1835 → 1845 · Ten years</label></labels>
      <smart-layout orientation="horizontal" variant="minimalTimelineWithBoxes">
        <smart-layout-item>
          <h4>1835 · Conflict begins</h4>
          <p>Political conflict begins in Rio Grande do Sul.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>1835–1845 · A long middle</h4>
          <p>Disagreement continues while families and workers live through years of uncertainty.</p>
        </smart-layout-item>
        <smart-layout-item>
          <h4>1845 · Conflict ends</h4>
          <p>The ten-year conflict comes to an end.</p>
        </smart-layout-item>
      </smart-layout>
      <grid spacing="none" vertical-sizing="hug">
        <grid-item background-color="palette-3" padding="14pt 18pt">
          <h4>Time check</h4>
          <p>Ten years is longer than most children spend in primary school.</p>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>