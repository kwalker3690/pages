<section>
  <grid divider="sm neutral-border">
    <grid-item colspan="24" vertical-align="center" padding="58pt 42pt 48pt 56pt">
      <hr horizontalAlign="left" width="xs" thickness="md" color="accent"/>
      <h1>Start with One Cue</h1>
      <p font-size="lg">Bring one reference: a line, a movement or a texture. A stylist can translate that cue into a wearable plan.</p>
      <spacer mode="fill"/>
      <p role="caption">AI concept imagery — not salon work.</p>
    </grid-item>
    <grid-item colspan="36" vertical-align="center" background-color="surface" padding="32pt">
      <grid spacing="small" vertical-sizing="hug" image-aspect="landscape" image-shape="square">
        <grid-item colspan="30">
          <ai-image aspect-ratio="landscape" image-style="sculptural-hair-editorial" prompt="Contact-sheet beauty frame of an adult East Asian model in profile, isolating the exact jaw-length line of a contour bob against gallery cream, warm directional studio light, realistic strands, restrained wardrobe and subtle film grain, hair fully visible, no hands, no text or lettering"></ai-image>
        </grid-item>
        <grid-item colspan="30">
          <ai-image aspect-ratio="landscape" image-style="sculptural-hair-editorial" prompt="Contact-sheet beauty frame of an adult South Asian model in three-quarter view, isolating curtain fringe opening at the cheekbone and merging into long face-framing layers, warm directional studio light, gallery-cream background, realistic strands and subtle film grain, no hands, no text or lettering"></ai-image>
        </grid-item>
        <grid-item colspan="30">
          <ai-image aspect-ratio="landscape" image-style="sculptural-hair-editorial" prompt="Contact-sheet beauty frame of an adult Black model showing rounded natural curl volume beside the face, distinct curl clusters and realistic variation under warm directional studio light, gallery-cream background, restrained wardrobe and subtle film grain, no hands, no text or lettering"></ai-image>
        </grid-item>
        <grid-item colspan="30">
          <ai-image aspect-ratio="landscape" image-style="sculptural-hair-editorial" prompt="Contact-sheet beauty frame of an adult Black model in profile showing clean braided lines converging toward a low sculpted knot with softly released ends, warm directional studio light, gallery-cream background, realistic braid detail and subtle film grain, no hands, no text or lettering"></ai-image>
        </grid-item>
      </grid>
    </grid-item>
  </grid>
</section>