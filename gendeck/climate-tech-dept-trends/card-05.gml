<SECTION image-layout="behind">
  <IMG class="accent-image" query="smart grid control room with multiple monitors displaying power distribution networks and renewable energy data">
  <DIV class="body">
    <COLUMNS colWidths="[50,50]">
      <DIV>
        <H4><B><SPAN text-color="#228B22">Infrastructure gaps</SPAN></B></H4>
        <SMART-LAYOUT variant="solidBoxes" cellSize="10">
          <SMART-LAYOUT-ITEM>
            <P>Transmission capacity lags renewable generation by 3-5 years</P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P>Rural grid connections limit wind farm development</P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P>Aging substations can't handle bidirectional power flows</P>
          </SMART-LAYOUT-ITEM>
        </SMART-LAYOUT>
      </DIV>
      <DIV>
        <H4><B><SPAN text-color="#228B22">Investment priorities</SPAN></B></H4>
        <SMART-LAYOUT variant="solidBoxes" cellSize="10">
          <SMART-LAYOUT-ITEM>
            <P>$2.4T needed for transmission upgrades through 2030</P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P>Smart grid sensors reduce outages by 35%</P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P>High-voltage DC lines enable cross-continental energy trading</P>
          </SMART-LAYOUT-ITEM>
        </SMART-LAYOUT>
      </DIV>
    </COLUMNS>
  </DIV>
</SECTION>