<SECTION image-layout="behind">
  <IMG class="accent-image" query="next-gen solar panel manufacturing facility with advanced production lines and cutting-edge photovoltaic technology">
  <DIV class="body">
    <H2><B>Innovation to market acceleration</B></H2>
    <COLUMNS colWidths="[50,50]">
      <DIV>
        <H4><B><SPAN text-color="#FF8C00">Technology readiness</SPAN></B></H4>
        <SMART-LAYOUT variant="solidBoxes" cellSize="10">
          <SMART-LAYOUT-ITEM>
            <P><B>Solid-state batteries reach pilot production in Q3 2025</B></P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P><B>Floating offshore wind scales to 15 GW pipeline</B></P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P><B>Green ammonia production costs drop below fossil fuels</B></P>
          </SMART-LAYOUT-ITEM>
        </SMART-LAYOUT>
      </DIV>
      <DIV>
        <H4><B><SPAN text-color="#FF8C00">Market deployment</SPAN></B></H4>
        <SMART-LAYOUT variant="solidBoxes" cellSize="10">
          <SMART-LAYOUT-ITEM>
            <P><B>Manufacturing capacity limits constrain 40% of ready technologies</B></P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P><B>Supply chain localization reduces deployment risk</B></P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM>
            <P><B>First-mover advantage creates winner-take-all dynamics</B></P>
          </SMART-LAYOUT-ITEM>
        </SMART-LAYOUT>
      </DIV>
    </COLUMNS>
  </DIV>
</SECTION>