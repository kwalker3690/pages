<SECTION image-layout="blank" background-color="#F4E6D1">
  <DIV class="body">
    <COLUMNS colwidths="[35,65]">
      <DIV data-vertical-align="start">
        <H1>What <SPAN text-color="#0EA5E9">Remains</SPAN></H1>
        <LABELS><LABEL color="#0EA5E9" variant="solid">Reality Check</LABEL></LABELS>
      </DIV>
      <DIV data-vertical-align="center" data-background-color="#2D4A3E">
        <SMART-LAYOUT color="#2D4A3E" cellsize="10" variant="solidBoxes">
          <SMART-LAYOUT-ITEM color="#4A6B5A">
            <H4><B>Materials</B></H4>
            <P>Lithium demand exceeds supply by 2030</P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM color="#3D5A4A">
            <H4><SPAN text-color="#FFFFFF"><B>Infrastructure</B></SPAN></H4>
            <P><SPAN text-color="#FFFFFF">Grid upgrades need $14T investment</SPAN></P>
          </SMART-LAYOUT-ITEM>
          <SMART-LAYOUT-ITEM color="#2D4A3E">
            <H4><SPAN text-color="#FFFFFF"><B>Speed</B></SPAN></H4>
            <P><SPAN text-color="#FFFFFF">Deployment lags 5x behind Paris targets</SPAN></P>
          </SMART-LAYOUT-ITEM>
        </SMART-LAYOUT>
      </DIV>
    </COLUMNS>
  </DIV>
</SECTION>