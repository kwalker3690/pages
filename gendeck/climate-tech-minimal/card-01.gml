<SECTION image-layout="blank" background-color="#2D4A3E">
  <DIV class="body">
    <LABELS><LABEL color="#0EA5E9" variant="solid">Three Forces</LABEL></LABELS>
    <H1 style="text-align: left"><span text-color="#0EA5E9">Convergence</span></H1>
    <SMART-LAYOUT color="#2D4A3E" cellsize="10" variant="solidBoxes" horizontalAlign="left">
      <SMART-LAYOUT-ITEM color="#4A6B5A">
        <H4 style="text-align: left"><B><span text-color="#FFFFFF">Economics</span></B></H4>
        <P style="text-align: left"><span text-color="#FFFFFF">Solar hits $0.02/kWh, cheaper than coal everywhere</span></P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM color="#3F5D4F">
        <H4 style="text-align: left"><B><span text-color="#FFFFFF">Policy</span></B></H4>
        <P style="text-align: left"><span text-color="#FFFFFF">$1.2T climate funding unlocked globally</span></P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM color="#355043">
        <H4 style="text-align: left"><B><span text-color="#FFFFFF">Technology</span></B></H4>
        <P style="text-align: left"><span text-color="#FFFFFF">Battery costs drop 89% in decade</span></P>
      </SMART-LAYOUT-ITEM>
    </SMART-LAYOUT>
  </DIV>
</SECTION>