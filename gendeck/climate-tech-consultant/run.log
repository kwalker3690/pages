- If image-layout is left/right/top/behind: SECTION contains <IMG class="accent-image"> BEFORE <DIV class="body">
- COLUMNS contains <DIV> elements. Every column MUST have content — never create empty <DIV></DIV> columns.
- If image-layout is left/right, the image is at the section level. Do NOT create COLUMNS to reserve space for the image. Use full-width content instead.
- data-vertical-align on DIV inside COLUMNS: start, center, or end
- data-background-color on at most ONE DIV inside COLUMNS
- SMART-LAYOUT supports horizontalAlign attribute: left, center, or right. Apply this when alignment is specified.
- Text alignment: style="text-align: left" or style="text-align: right" on text blocks
- If spatial description says "left-aligned" or "right-aligned", apply to ALL text blocks AND set horizontalAlign on any SMART-LAYOUT tags
- When the spatial description names a content type (metrics display, sequential process, parallel items), use the appropriate SMART-LAYOUT variant from the guide's block rules. "metrics display" → stats variant. "sequential process" → topLineText variant. "parallel items" → outlineBoxes variant.

## Design Guide — Block Rules
import type { BlocksConfig } from '../schema'

export const consultantBlocks: BlocksConfig = {
  section: {
    imageLayoutPreferences: {
      preferred: ['blank'],
      avoided: ['left', 'right', 'top', 'behind'],
    },
    verticalAlignDefault: null, // Dense cards fill top to bottom, no anchoring
    backgroundColorAllowed: true,
  },

  columns: {
    allowed: true,
    preferredSplits: ['50,50', '60,40', '40,60', '33,33,34'],
    maxColumns: 3,
    guidance: `Use columns heavily. 50/50 for chart+analysis. 33/33/34 for tier comparisons.
At least one column per card should have data-background-color for emphasis panels.
Both/all columns should have content — no empty columns in consultant style.`,
  },

  text: {
    roleMapping: {
      heroMoment: 'DISPLAY:md',       // Large numbers and title splashes
      cardTitle: 'H1',                // Bold H1 for card headings
      supporting: 'H4',               // H4 for subheadings within zones
      metadata: 'LABEL:solid',        // Section markers on every card
    },
    emphasisMethod: 'bold',
    textColorSpans: {
      frequency: 'occasional',
      maxWordsPerSpan: 4,
    },
    defaultTextAlign: 'left',
  },

  smartLayout: {
    allowed: true,
    preferredVariants: [
      'solidBoxes',
      'solidLeafBoxes',
      'topLineText',
      'stats',
      'starStats',
      'solidJoinedBoxes',
    ],
    avoidedVariants: [
      'flower',
      'semiCircle',
      'cycle',
      'ring',
      'speechBubbles',
      'quoteBoxes',
      'imagesText',
      'staircase',
      'pyramid',
    ],
    maxFamiliesPerDeck: undefined, // unlimited — semantic matching per card
    maxItemsPerLayout: 4,
    variantPreferenceOrder: {
      boxes: ['solidBoxes', 'solidJoinedBoxes', 'solidLeafBoxes'],
      stats: ['stats', 'starStats', 'circleStats'],
      steps: ['processSteps', 'stepsWithArrow'],
      text: ['topLineText'],
      circles: ['cycle'],
    },
    guidance: `Dense, corporate variants only.
solidBoxes / solidLeafBoxes: for parallel items, tier features, framework components. Colored backgrounds are key.
solidJoinedBoxes: for tightly coupled items (phases, pillars) that belong together visually.
topLineText: for lightweight lists within a zone — bullet-style items with clear separation.
stats / starStats: for hero numbers. 3-4 items. Short labels. Use starStats for ratings/scores.
Icons inside smart layout items are encouraged — use ICON tag for visual markers.`,
    variantGuidance: {
      solidBoxes: 'Primary structured layout. Colored backgrounds. Use for framework components, service tiers, capability blocks.',
      solidLeafBoxes: 'Variant of solidBoxes with rounded corners. Use for softer analytical content.',
      solidJoinedBoxes: 'Connected blocks for phases or tightly coupled items. Use for frameworks, processes.',
      stats: 'Hero numbers with labels. 3-4 items max. Short descriptive labels beneath numbers.',
      starStats: 'Star-rated metrics. Use for scores, ratings, satisfaction percentages.',
      topLineText: 'Clean list items with top border. For supporting bullet points within a zone.',
    },
  },

  display: {
    allowed: true,
    guidance: `Use for title card splash text and hero statistics. DISPLAY with md size for card titles on the opening card.
For hero numbers, prefer stats layout over individual DISPLAY elements. But a single giant number (like "277") can use DISPLAY.`,
  },

  aside: {
    allowed: true,
    guidance: `For key takeaways after data sections. Full-width, below columns. Use "note" variant.
Good for single-line summaries that anchor the bottom of a dense card.`,
  },

  blockquote: {
    allowed: true,
    guidance: `For testimonials, expert quotes, and key statements. Include attribution.
Use on closing cards and evidence cards. Pair with supporting data.`,
  },

  labels: {
    allowed: true,
    guidance: `REQUIRED on every card except the title card. Section markers: OVERVIEW, KEY INSIGHTS, ANALYSIS, STRATEGY, RESULTS, CONCLUSION, etc.
Use solid variant. Place above H1. Include an ICON inside the label for visual weight.
Example: <LABELS><LABEL variant="solid"><ICON name="chart-bar" /> ANALYSIS</LABEL></LABELS>`,
  },

  ul: {
    allowed: true,
    guidance: `Heavy use. 4-6 items per list. Dense bullet points with specific data.
Inside colored panels, inside smart layout items, standalone beneath headings.`,
  },

  ol: {
    allowed: true,
    guidance: 'For numbered steps in processes and frameworks.',
  },

  table: {
    allowed: true,
    guidance: `For metric comparisons, benchmarking data, feature matrices. 3-5 rows typical.
Use colwidths for alignment. Bold the header row. Include specific numbers in cells.
Good for "Industry Average vs Our Clients" comparisons.`,
  },

  chart: {
    allowed: true,
    guidance: `Use sparingly — maximum 1 chart per deck, and only when the card's primary purpose is data comparison.
Prefer stats layouts, tables, and colored panels for data density instead.
If used: bar or column chart only. Always pair with analysis text in the other column.
Charts take significant vertical space — do not combine with other heavy elements on the same card.`,
  },

  gallery: {
    allowed: false,
    guidance: 'No image galleries in consultant decks.',
  },

  infographic: {
    allowed: false,
    guidance: 'Use charts and stats instead.',
  },

  diagram: {
    allowed: false,
    guidance: 'Use solidJoinedBoxes or solidBoxes smart layouts for process/framework diagrams.',
  },
}


