      <SMART-LAYOUT-ITEM number="$18.5M">
        <P><SPAN text-color="#FFFFFF">Series A median pre-money, 15% above 2023 levels</SPAN></P>
      </SMART-LAYOUT-ITEM>
    </SMART-LAYOUT>
    <COLUMNS colWidths="[60,40]">
      <DIV>
        <H4><SPAN text-color="#FFFFFF">Primary Investment Sectors</SPAN></H4>
        <UL>
          <LI><SPAN text-color="#FFFFFF"><B>Energy storage systems:</B> $847B market, lithium-ion and next-gen batteries</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Carbon capture utilization:</B> $340B addressable, direct air capture scaling</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Grid modernization tech:</B> $298B opportunity, smart infrastructure deployment</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Green hydrogen production:</B> $183B market, electrolysis cost reduction</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Synthetic biology fuels:</B> $127B potential, bio-based chemical alternatives</SPAN></LI>
        </UL>
