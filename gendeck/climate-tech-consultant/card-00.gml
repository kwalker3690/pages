<SECTION image-layout="blank" background-color="#1E293B">
  <DIV class="body">
    <LABELS><LABEL variant="solid"><ICON name="chart-bar" /> OVERVIEW</LABEL></LABELS>
    <DISPLAY size="md"><SPAN text-color="#FFFFFF">Climate Tech Investment Reaches $2.8T Market Opportunity with 23% CAGR Through 2030</SPAN></DISPLAY>
    <SMART-LAYOUT variant="stats" cellSize="15">
      <SMART-LAYOUT-ITEM number="$2.8T">
        <P><SPAN text-color="#FFFFFF">Total addressable market by 2030, up from $1.1T in 2023</SPAN></P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM number="23%">
        <P><SPAN text-color="#FFFFFF">CAGR outpaces traditional energy (4.2%)</SPAN></P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM number="3,847">
        <P><SPAN text-color="#FFFFFF">Transactions closed in 2024, $94B deployed globally</SPAN></P>
