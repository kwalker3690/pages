<SECTION image-layout="blank">
  <DIV class="body">
    <LABELS><LABEL variant="solid"><ICON name="trending-up" /> STRATEGY</LABEL></LABELS>
    <H1>Three Investment Tiers Optimize Risk-Adjusted Returns from 12% to 34% IRR</H1>
    <COLUMNS colWidths="[33,33,34]">
      <DIV>
        <H2>Proven Technology Tier</H2>
        <UL>
          <LI><B>Risk profile:</B> Low technical risk, regulatory/market risk only, 85% success probability</LI>
          <LI><B>Capital requirements:</B> $10-50M typical check size, 18-month deployment timeline</LI>
          <LI><B>Expected returns:</B> 12-18% IRR, 2.5-4x exit multiples, 5-7 year hold periods</LI>
          <LI><B>Example companies:</B> Fluence Energy (grid storage, $2.8B revenue), First Solar (thin-film PV, 23% efficiency gains)</LI>
        </UL>
      </DIV>
      <DIV>
        <H2>Emerging Scale Tier</H2>
        <UL>
          <LI><B>Risk profile:</B> Medium technical risk, scaling challenges, 45% success probability</LI>
          <LI><B>Capital requirements:</B> $25-150M check size, 36-month deployment timeline</LI>
          <LI><B>Expected returns:</B> 22-28% IRR, 5-8x exit multiples, 6-9 year hold periods</LI>
          <LI><B>Example companies:</B> Climeworks (DAC leader, $650M raised), Plug Power (hydrogen infrastructure, $5.1B market cap)</LI>
        </UL>
      </DIV>
      <DIV data-background-color="#10B981">
        <H2><SPAN text-color="#FFFFFF">Moonshot Technology Tier</SPAN></H2>
        <UL>
          <LI><SPAN text-color="#FFFFFF"><B>Risk profile:</B> High technical risk, breakthrough potential, 15% success probability</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Capital requirements:</B> $50-500M check size, 60-month deployment timeline</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Expected returns:</B> 34-45% IRR, 10-25x exit multiples, 8-12 year hold periods</SPAN></LI>
          <LI><SPAN text-color="#FFFFFF"><B>Example companies:</B> Commonwealth Fusion (fusion energy, $2B raised), Zymergen (synthetic biology, acquired by Ginkgo for $3B)</SPAN></LI>
        </UL>
      </DIV>
    </COLUMNS>
    <SMART-LAYOUT variant="solidBoxes" cellSize="15">
      <SMART-LAYOUT-ITEM>
        <H4>Conservative Allocation</H4>
        <P>60% Proven, 30% Emerging, 10% Moonshot (14% blended IRR)</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM>
        <H4>Balanced Allocation</H4>
        <P>40% Proven, 40% Emerging, 20% Moonshot (19% blended IRR)</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM>
        <H4>Aggressive Allocation</H4>
        <P>20% Proven, 50% Emerging, 30% Moonshot (26% blended IRR)</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM>
        <H4>Diversification Minimum</H4>
        <P>15+ companies across 5+ sectors, no single investment >8% of portfolio</P>
      </SMART-LAYOUT-ITEM>
    </SMART-LAYOUT>
  </DIV>
</SECTION>