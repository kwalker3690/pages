<SECTION image-layout="blank">
  <DIV class="body">
    <LABELS><LABEL variant="solid"><ICON name="chart-bar" /> KEY INSIGHTS</LABEL></LABELS>
    <H1 style="text-align: left">Energy Storage and Carbon Capture Lead $847B in New Funding Commitments</H1>
    <COLUMNS colWidths="[33,33,34]">
      <DIV>
        <H4 style="text-align: left">Energy Storage</H4>
        <UL>
          <LI style="text-align: left"><B>$24.7B</B> deployed across 847 deals</LI>
          <LI style="text-align: left"><B>67% YoY</B> growth rate</LI>
          <LI style="text-align: left">Leading utility-scale battery deployments</LI>
          <LI style="text-align: left">Grid stabilization demand driving expansion</LI>
        </UL>
      </DIV>
      <DIV>
        <H4 style="text-align: left">Carbon Capture</H4>
        <UL>
          <LI style="text-align: left"><B>$18.3B</B> funding across 312 deals</LI>
          <LI style="text-align: left"><B>89% YoY</B> growth rate</LI>
          <LI style="text-align: left">Direct air capture scaling rapidly</LI>
          <LI style="text-align: left">Industrial point-source applications</LI>
        </UL>
      </DIV>
      <DIV>
        <H4 style="text-align: left">Grid Infrastructure</H4>
        <UL>
          <LI style="text-align: left"><B>$15.9B</B> committed across 523 deals</LI>
          <LI style="text-align: left"><B>34% YoY</B> growth rate</LI>
          <LI style="text-align: left">Smart grid modernization focus</LI>
          <LI style="text-align: left">Transmission capacity bottlenecks</LI>
        </UL>
      </DIV>
    </COLUMNS>
    <SMART-LAYOUT variant="solidBoxes" cellSize="15" horizontalAlign="left">
      <SMART-LAYOUT-ITEM>
        <H4 style="text-align: left">Green Hydrogen</H4>
        <P style="text-align: left"><B>$12.1B</B> raised, 298 deals, <B>156% YoY</B> growth rate</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM>
        <H4 style="text-align: left">Synthetic Biology</H4>
        <P style="text-align: left"><B>$8.4B</B> deployed, 187 deals, <B>203% YoY</B> growth rate</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM>
        <H4 style="text-align: left">Geothermal Tech</H4>
        <P style="text-align: left"><B>$4.2B</B> funding, 134 deals, <B>78% YoY</B> growth rate</P>
      </SMART-LAYOUT-ITEM>
    </SMART-LAYOUT>
    <DIV data-background-color="#4338CA">
      <H4 style="text-align: left"><SPAN text-color="#FFFFFF">Regulatory Catalysts Driving Growth</SPAN></H4>
      <UL>
        <LI style="text-align: left"><SPAN text-color="#FFFFFF"><B>Inflation Reduction Act:</B> $369B in climate incentives, 10-year tax credit extensions</SPAN></LI>
        <LI style="text-align: left"><SPAN text-color="#FFFFFF"><B>EU Taxonomy Regulation:</B> €1.8T sustainable investment classification framework</SPAN></LI>
        <LI style="text-align: left"><SPAN text-color="#FFFFFF"><B>Carbon Border Adjustments:</B> EU CBAM creates $43B annual compliance market</SPAN></LI>
        <LI style="text-align: left"><SPAN text-color="#FFFFFF"><B>Voluntary carbon markets:</B> $2B current, scaling to $100B by 2030</SPAN></LI>
      </UL>
    </DIV>
    <SMART-LAYOUT variant="stats" cellSize="15" horizontalAlign="left">
      <SMART-LAYOUT-ITEM number="$94B">
        <P style="text-align: left">Climate VC deployment 2024 vs $67B traditional energy investment</P>
      </SMART-LAYOUT-ITEM>
      <SMART-LAYOUT-ITEM number="40%">
        <P style="text-align: left">Premium for climate tech over traditional energy sectors</P>
      </SMART-LAYOUT-ITEM>
    </SMART-LAYOUT>
  </DIV>
</SECTION>